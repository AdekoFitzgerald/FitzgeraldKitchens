(setq 10179604_Bkanat_DONOTOPTIMIZE T)
(defun 10179604_Bkanat (x z)
	(cond 
		((member kulp '("0-" )) (ALUKULPSUZ_Bkanat x z))
		((member kulp '("K-" "G-" )) (ALUALTPRF_Bkanat x z))
		((member kulp '("GD" "KD" "D")) (ALUBOYKPK_Bkanat x z))
		(T (ALUBOYKPK_Bkanat x z))
	)
