(defun 1034_Akanat (x z)
	(drawMeshKanat nil "1034" x z
		(list
			(list "CAB_DOORS"
				nil
				'( 8 6 4 2 )
				'( 7 5 3 1 )
				'( 8 7 2 1 )
				'( )
			)
			(list "CAB_DOOR_FRAMES"
				nil
				'( 24 23 22 21 20 19 18 17 14 13 11 9 7 5 2 1 )
				'( 32 31 30 29 28 27 26 25 16 15 12 10 8 6 4 3 )
				'( 32 31 30 29 28 27 26 25 24 23 22 21 20 19 18 17 )
				'( )
			)
)))
 (defun 1034_Bkanat (x z)
	(drawMeshKanat nil "1034C" x z
		(list
			(list "CAB_DOOR_FRAMES"
				(list (cm -0.5) 13 23 32 15)
				'( 24 23 22 21 20 19 18 17 14 13 11 9 7 5 2 1 )
				'( 32 31 30 29 28 27 26 25 16 15 12 10 8 6 4 3 )
				'( 32 31 30 29 28 27 26 25 24 23 22 21 20 19 18 17 ) 
				'( ) 
			) 
)))
(defun 1034_Ckanat (x z)
      (1034_Akanat  x z)
)
