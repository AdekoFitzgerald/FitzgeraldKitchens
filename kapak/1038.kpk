(defun 1038_Akanat (x z)
    (if (or (< z  25)
            (< x 25)
        )
        (DUZKPK_Akanat x z)
	(progn
		(drawMeshKanat nil "1038" x z
		(list
			(list "CAB_DOORS"
				nil
				'( 8 6 4 2 )
				'( 7 5 3 1 )
				'( 8 7 2 1 )
				'( )
			)
			(list "CAB_DOOR_FRAMES"
				nil
				'( 18 17 16 15 14 13 10 9 6 5 2 1 )
				'( 24 23 22 21 20 19 12 11 8 7 4 3 )
				'( 24 23 22 21 20 19 18 17 16 15 14 13 )
				'( )
			)
)))))
 (defun 1038_Bkanat (x z)
	(drawMeshKanat nil "1038C" x z
		(list
			(list "CAB_DOOR_FRAMES"
				(list (cm -0.5) 1 15 20 3)
				'( 18 17 16 15 14 13 10 9 6 5 2 1 )
				'( 24 23 22 21 20 19 12 11 8 7 4 3 )
				'( 24 23 22 21 20 19 18 17 16 15 14 13 )
				'( )
			)
)))
