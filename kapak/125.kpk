(defun 125_Akanat (x z)
	(setq Ta (cm 3.0) Sa (cm 3.0))
	(if (< z (cm 16.0))
		(drawMeshKanat nil "125S" x z
			(list
				(list "CAB_DOORS"
					nil
					'( 40 38 36 33 29 28 27 25 23 21 20 17 15 13 12 11 4 3 2 1 )
					'( 39 37 35 34 32 31 30 26 24 22 19 18 16 14 10 9 8 7 6 5 )
					'( 38 37 34 33 26 25 24 23 22 21 16 15 14 13 11 9 7 5 2 1 )
					'( )
				)
			)
		)
		(progn
			(if (or (< x (cm 30.0))
				    (< z (cm 30.0))
				)
				(drawMeshKanat nil "125-20" x z
					(list
						(list "CAB_DOORS"
							nil
							'( 68 65 62 61 57 56 55 53 51 49 48 45 42 41 40 39 38 37 30 29 24 23 22 21 20 16 15 14 11 6 4 3 2 1 )
							'( 67 66 64 63 60 59 58 54 52 50 47 46 44 43 36 35 34 33 32 31 28 27 26 25 19 18 17 13 12 10 9 8 7 5 )
							'( 66 65 63 62 54 53 52 51 50 49 44 43 42 41 39 33 32 31 30 29 28 27 26 25 24 23 22 21 8 7 6 5 4 3 )
							'( )
						)
					)
				)
				(drawMeshKanat nil "125" x z
					(list
						(list "CAB_DOORS"
							nil
							'( 80 77 74 73 69 68 67 65 63 61 60 57 54 53 52 51 50 49 42 41 33 32 31 30 29 28 27 26 22 21 20 17 13 10 9 6 4 3 2 1 )
							'( 79 78 76 75 72 71 70 66 64 62 59 58 56 55 48 47 46 45 44 43 40 39 38 37 36 35 34 25 24 23 19 18 16 15 14 12 11 8 7 5 )
							'( 78 77 75 74 66 65 64 63 62 61 56 55 54 53 51 45 44 43 42 41 40 39 38 37 36 35 34 33 32 31 30 29 28 27 8 7 6 5 4 3 )
							'( )
						)
))))))
(defun 125_Bkanat (x z)
	(setq Ta (cm 3.0) Sa (cm 3.0))
	(drawMeshKanat nil "125C" x z
		(list
			(list "CAB_DOORS"
				(list (cm -0.5) 2 4 6 8)
				'( 72 70 66 65 61 60 59 57 54 53 52 49 47 46 44 43 42 41 34 33 29 28 27 26 23 21 19 14 12 11 10 9 4 3 2 1 )
				'( 71 69 68 67 64 63 62 58 56 55 51 50 48 45 40 39 38 37 36 35 32 31 30 25 24 22 20 18 17 16 15 13 8 7 6 5 )
				'( 70 69 67 66 58 57 56 55 54 53 48 47 46 45 43 37 36 35 34 33 32 31 30 29 28 27 16 15 14 13 12 11 6 5 4 3 )
				'( )
			)
)))
(defun 125_Ckanat (x z)
	(125_Akanat x z)
)

