					'( 72 71 68 67 66 65 59 58 57 55 48 47 46 45 44 43 42 41 34 33 28 27 26 25 22 18 17 16 15 12 9 5 4 3 2 1 ) 
					'( ) 
				) 
			)
		)
	)
)

