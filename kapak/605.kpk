(setq 605_Akanat_DONOTOPTIMIZE T)
(defun 605_Akanat (x z)
	(setq Ta (cm 3.0) Sa (cm 3.0))
	(cond ((< z (cm 20.0))
			(drawMeshKanat nil "605S" x z
				(list
					(list "CAB_DOORS"
						nil
						'( 23 21 20 19 16 15 14 13 12 11 10 9 )
						'( 24 22 18 17 8 7 6 5 4 3 2 1 )
						'( 24 23 22 21 16 14 11 9 7 5 4 2 )
						'( )
					)
				)
			)
		  )
		  ((< x (cm 20.0))
			(drawMeshKanat nil "605SS" x z
				(list
					(list "CAB_DOORS"
						nil
						'( 20 19 18 17 16 14 11 9 7 5 4 2 )
						'( 24 23 22 21 15 13 12 10 8 6 3 1 )
						'( 22 21 20 19 16 15 14 13 12 11 10 9 )
						'( )
					)
				)
			)
		   )
		   (T
			(drawMeshKanat nil "605" x z
				(list
					(list "CAB_DOORS"
						nil
						'( 32 31 30 29 28 27 19 17 12 11 10 9 8 6 4 2 )
						'( 26 25 24 23 22 21 20 18 16 15 14 13 7 5 3 1 )
						'( 31 29 27 25 23 21 18 17 16 14 12 11 4 3 2 1 )
						'( )
					)
				)
			)
		  )
	)
)

(setq 605_Bkanat_DONOTOPTIMIZE T)
(defun 605_Bkanat (x z)
	(setq Ta (cm 3.0) Sa (cm 3.0))
	(drawMeshKanat nil "605C" x z
		(list
			(list "CAB_DOORS"
				(list (cm -0.5) 4 10 12 2)
				'( 40 39 38 37 36 35 34 24 23 19 18 17 15 11 10 9 8 6 5 4 )
				'( 33 32 31 30 29 28 27 26 25 22 21 20 16 14 13 12 7 3 2 1 )
				'( 39 37 29 27 26 24 22 21 20 19 18 17 16 15 14 13 12 11 10 9 )
				'( )
			)
)))
(defun 605_Ckanat (x z)
	(605_Akanat x z)
)

