(defun 7CM_Akanat (x z)
	(setq Ta (cm 3.5) Sa (cm 3.5))
    (if (or (< z (cm 20)) (< x (cm 20)))
	(drawMeshKanat nil "7CMS" x z
		(list
			(list "CAB_DOORS"
				nil
				'( 31 30 29 28 27 26 25 24 23 21 20 19 18 13 11 10 4 3 2 1 )
				'( 40 39 38 37 36 35 34 33 32 22 17 16 15 14 12 9 8 7 6 5 )
				'( 40 39 38 37 36 35 34 33 32 31 30 29 28 27 26 25 24 23 22 21 )
				'( )
			)
                 )
        )
	(drawMeshKanat nil "7CM" x z
		(list
			(list "CAB_DOORS"
				nil
				'( 60 58 57 56 51 50 47 39 38 37 36 35 34 33 32 31 30 29 23 22 20 18 12 10 9 8 7 5 3 1 )
				'( 59 55 54 53 52 49 48 46 45 44 43 42 41 40 28 27 26 25 24 21 19 17 16 15 14 13 11 6 4 2 )
				'( 56 55 54 53 52 51 50 47 46 44 42 38 36 34 32 31 30 29 28 27 26 25 24 23 22 21 20 19 18 17 )
				'( )
			)
))))
(setq Ta (cm 3.5) Sa (cm 3.5))
 (defun 7CM_Bkanat (x z)
	(drawMeshKanat nil "7CMC" x z
		(list
			(list "CAB_DOORS"
				(list (cm -0.5) 12 47 54 13)
				'( 60 58 57 56 51 50 47 39 38 37 36 35 34 33 32 31 30 29 23 22 20 18 12 10 9 8 7 5 3 1 )
				'( 59 55 54 53 52 49 48 46 45 44 43 42 41 40 28 27 26 25 24 21 19 17 16 15 14 13 11 6 4 2 )
				'( 56 55 54 53 52 51 50 47 46 44 42 38 36 34 32 31 30 29 28 27 26 25 24 23 22 21 20 19 18 17 )
				'( )
			)
)))
(defun 7CM_Ckanat (x z)
       (7CM_Akanat x z)
)
