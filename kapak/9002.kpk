(if (null 900X_kanat) (load (strcat ad_ADEKOPath "kapak\\9001.kpk")))

(defun 9002_Akanat (x z / LFT RGT UP)
	(if (or (< z (cm 19.0)) (< x (cm 19.0)))
		(9001_Akanat x z)
		(progn
			(setq LFT '(1 4 7 8 10 11 14 15 17 18 20 22)
		    	  RGT '(2 3 5 6 9 12 13 16 19 21 23 24)
			      UP  '(1 2 4 5 8 9 16 17 18 19 20 24)
;			      DWN '(3 6 7 10 11 12 13 14 15 21 22 23)
			)
			(900X_kanat x z "9002" LFT RGT UP nil nil)
	)	)
)

(defun 9002_Bkanat (x z / LFT RGT UP)
	(setq LFT '(1 4 6 8 9 10 15 16)
	      RGT '(2 3 5 7 11 12 13 14)
	   	  UP  '(1 2 4 5 11 14 15 16)
;	      DWN '(3 6 7 8 9 10 12 13)
	)
	(900X_kanat x z "9001C" LFT RGT UP nil '(6 15 14 12))
)

(defun 9002_Ckanat (x z)
	(9002_Akanat x z)
)
