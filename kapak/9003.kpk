(if (null 900X_kanat) (load (strcat ad_ADEKOPath "kapak\\9001.kpk")))

(defun 9003_Akanat (x z / LFT RGT UP)
	(if (or (< z (cm 26.8)) (< x (cm 26.8)))
		(9001_Akanat x z)
		(progn
			(setq LFT '(1 3 4 7 8 12 13 16 18 19 20 21 26 28 29 32 33 38 39 40)
		    	  RGT '(2 5 6 9 10 11 14 15 17 22 23 24 25 27 30 31 34 35 36 37)
			      UP  '(1 2 4 6 7 9 13 14 17 19 22 32 33 34 35 36 37 38 39 40)
;			      DWN '(3 5 8 10 11 12 15 16 18 20 21 23 24 25 26 27 28 29 30 31)
			)
			(900X_kanat x z "9003" LFT RGT UP nil nil)
	)	)
)

(defun 9003_Bkanat (x z / LFT RGT UP)
	(setq LFT '(1 5 6 7 10 14 15 18 20 21 22 24)
	      RGT '(2 3 4 8 9 11 12 13 16 17 19 23)
	      UP  '(1 2 6 7 8 9 11 16 21 22 23 24)
;	      DWN '(3 4 5 10 12 13 14 15 17 18 19 20)
	)
	(900X_kanat x z "9003C" LFT RGT UP nil T)
)

(defun 9003_Ckanat (x z)
	(9003_Akanat x z)
)
