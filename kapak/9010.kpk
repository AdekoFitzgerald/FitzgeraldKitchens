(if (null 900X_kanat) (load (strcat ad_ADEKOPath "kapak\\9001.kpk")))

(defun 9010_Akanat (x z / LFT RGT UP)
	(if (or (< z (cm 16.0)) (< x (cm 16.0)))
		(9001_Akanat x z)
		(progn
			(setq LFT '(4 6 7 9 10 14 15 16 19 20 23 25 26 28 31 33 34 35 36 40)
			      RGT '(1 2 3 5 8 11 12 13 17 18 21 22 24 27 29 30 32 37 38 39)
			      UP  '(1 2 4 5 6 9 13 14 20 24 25 26 27 29 30 31 34 36 38 39)
;			      DWN '(3 7 8 10 11 12 15 16 17 18 19 21 22 23 28 32 33 35 37 40)
			)
			(900X_kanat x z "9010" LFT RGT UP nil nil)
	)	)
)

(defun 9010_Bkanat (x z / LFT RGT UP)
	(setq LFT '(1 4 6 8 9 10 15 16)
	      RGT '(2 3 5 7 11 12 13 14)
	   	  UP  '(1 2 4 5 11 14 15 16)
;	      DWN '(3 6 7 8 9 10 12 13)
	)
	(900X_kanat x z "9001C" LFT RGT UP nil '(6 15 14 12))
)

(defun 9010_Ckanat (x z)
	(9010_Akanat x z)
)
