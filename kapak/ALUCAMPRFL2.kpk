(setq ALUCAMPRFL2_Bkanat_DONOTOPTIMIZE T)
(defun ALUCAMPRFL2_Bkanat (x z)
	(cond 
		((member kulp '("0-")) (BOYALMKULPYOK_Bkanat x z))
		((member kulp '("D-")) (BOYALMKULPYAN_Bkanat x z))
		(T (BOYALMKULPUST_Bkanat x z))
	)
)
