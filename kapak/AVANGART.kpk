	(drawMeshKanat nil "AVANGART" x z
		(list
			(list "CAB_DOORS"
				nil
				'(160 159 158 157 156 155 154 153 152 151 150 149 148 147 146 145 144 143 142 141 140 139 115 113 112 109 107 105 103 101 99 97 96 93 92 89 88 85 83 81 79 77 75 73 71 69 68 67 66 65 64 63 62 61 60 59 58 57 56 55 54 53 52 34 33 32 31 30 29 28 27 26 25 24 23 22 21 20 19 18 )
