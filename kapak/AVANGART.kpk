				'()
			)
			(list "CAB_DOOR_EDGE_BANDS"
				nil
				'(124 123 120 119 116 113 112 111 110 109 108 107 106 105 104 103 102 101 88 87 86 85 84 83 82 81 80 79 78 77 64 63 62 61 56 55 52 51 48 47 46 45 44 43 36 34 32 30 28 27 24 23 22 21 20 19 12 10 8 6 4 3 )
