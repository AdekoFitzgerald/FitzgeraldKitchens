(defun B137_Akanat (x z)
    (if (or (< z (cm 20)) (< x (cm 20)))
		(drawMeshKanat nil "B137S" x z
			(list
				(list "CAB_DOORS"
					nil
					'( 28 27 26 23 22 21 20 19 18 17 12 11 10 5 2 1 )
					'( 32 31 30 29 25 24 16 15 14 13 9 8 7 6 4 3 )
					'( 32 31 30 29 28 27 23 21 20 19 18 17 16 15 14 13 )
					'( )
				)
			)
		)
		(drawMeshKanat nil "B137" x z
			(list 
				(list "CAB_DOORS" 
					nil 
					'( 84 83 82 79 78 77 76 75 74 73 72 71 70 69 60 59 50 49 48 47 46 45 44 41 40 39 38 37 32 31 30 29 28 22 20 19 12 11 10 9 8 7 6 5 ) 
					'( 88 87 86 85 81 80 68 67 66 65 64 63 62 61 58 57 56 55 54 53 52 51 43 42 36 35 34 33 27 26 25 24 23 21 18 17 16 15 14 13 4 3 2 1 ) 
					'( 88 87 86 85 84 83 79 77 76 75 74 66 62 61 59 57 53 52 51 50 49 45 44 43 32 31 30 29 26 25 24 23 22 21 20 18 14 13 12 11 6 5 4 3 ) 
					'( ) 
				) 
			)
		)
	)
)

 (defun B137_Bkanat (x z)
	(drawMeshKanat nil "B137C" x z 
		(list 
			(list "CAB_DOORS" 
				(list (cm -0.5) 6 8 4 3)
				'( 76 75 74 71 70 69 68 67 66 65 64 63 62 61 52 51 42 41 40 39 38 37 36 33 32 31 30 29 24 23 22 21 20 14 12 11 8 7 6 5 ) 
				'( 80 79 78 77 73 72 60 59 58 57 56 55 54 53 50 49 48 47 46 45 44 43 35 34 28 27 26 25 19 18 17 16 15 13 10 9 4 3 2 1 ) 
				'( 80 79 78 77 76 75 71 69 68 67 66 58 54 53 51 49 45 44 43 42 41 37 36 35 24 23 22 21 18 17 16 15 14 13 12 10 8 7 4 2 ) 
				'( ) 
			) 
		)
	)
)

(defun B137_Ckanat (x z)
      (B137_Akanat  x z)
)
