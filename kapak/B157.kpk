		(list
			(list "CAB_DOORS"
				nil
				'( 51 50 45 44 43 42 41 40 32 31 30 29 28 26 24 22 20 18 16 14 12 10 7 6 5 4 )
				'( 52 49 48 47 46 39 38 37 36 35 34 33 27 25 23 21 19 17 15 13 11 9 8 3 2 1 )
				'( 52 50 49 46 45 39 38 33 32 31 30 29 18 17 16 15 14 13 12 11 10 9 5 4 2 1 )
				'( )
			)
)))
 (defun B157_Bkanat (x z)
	(drawMeshKanat nil "B157C" x z
		(list
			(list "CAB_DOORS"
				(list (cm -0.5) 2 4 6 8)
				'( 47 46 45 44 43 42 41 40 32 31 30 29 28 26 24 22 20 18 16 14 12 10 4 3 2 1 ) 
				'( 52 51 50 49 48 39 38 37 36 35 34 33 27 25 23 21 19 17 15 13 11 9 8 7 6 5 ) 
				'( 52 49 48 47 46 39 38 33 32 31 30 29 18 17 16 15 14 13 12 11 10 9 6 5 4 3 ) 
				'( ) 
			) 
)))
(defun B157_Ckanat (x z)
