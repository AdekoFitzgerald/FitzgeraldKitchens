;1- dikeykanallirpt.dwg'deki gibi tekrar eden kesiti çiz
;2- ÇD'yi istediðin yer koy, bu ÇD'ye göre noktalar hesaplanacaktýr.
;3- Bu durumda ÇD > Merkez > polyline'ýn sol uç noktasý.
;4- RPT komutunu gir,
;5- Profili olduðu yerde UÇ nokta yakalamayla sol baþtan seç
;6- Ekrana kodu dökülür; kopyala ve kpk dosyasýna yapýþtýr, <KapakAdi>ni deðiþtir
;Bu ka


;Yatay kesitte tekrar eden paternleri .kpk koduna çevirir
(defun c:rpt (/ szunit ent&ptorj ent eget pt samplepts)
	(setq szunit (cdr (assoc (getvar "INSUNITS") '((0 . "cm") (1 . "inch") (4 . "mm") (5 . "cm")))))
	(if (null szunit) (progn (alert "INSUNITS tanýmsýz birim.") (exit)))
	(setq ent&ptorj (entsel "\nPeriyot polyline'ý ve baþlangýç noktasý: "))
	(setq ent (car ent&ptorj) ptorj (cadr ent&ptorj))
	(setq samplepts (plpts ent))
	(if (not (equal (yof (last samplepts)) 0.0 0.01))
		(progn	
			(alert "Baþlangýç ve bitiþ noktalarý Y'de hizalý deðil. Düzelt de öyle gel.")
			(exit)
		)
	)
	(printf "\n(defun <KapakAdi>_Akanat (x z / samplepts)" nil)
	(printf "\n\t(setq samplepts (list" nil)
	(foreach pt samplepts
		(printf "\n\t\t(list (~s ~d) (~s ~d))" (list szUnit (xof pt) szunit (yof pt)))
	)
	(printf "\n\t))" nil)
	(printf "\n\t(dikeykanalli x z samplepts)" nil)
	(printf "\n)" nil)
)

;RPT komutu sonucu örnek çktý:
(defun BDALGA_Akanat (x z / samplepts)
    (setq samplepts (list
        (list (cm 0) (cm 0))
        (list (cm 0.16) (cm 0))
        (list (cm 0.48) (cm 0.1))
        (list (cm 0.75) (cm 0.29))
        (list (cm 1.02) (cm 0.48))
        (list (cm 1.34) (cm 0.58))
        (list (cm 1.66) (cm 0.58))
        (list (cm 1.98) (cm 0.48))
        (list (cm 2.25) (cm 0.29))
        (list (cm 2.52) (cm 0.1))
        (list (cm 2.84) (cm 0))
        (list (cm 3) (cm 0))
    ))
    (dikeykanalli x z samplepts)
)


(defun dikeykanalli (x z samplepts / sampleLen rpt rptLen duzluk oldthick lastx lasty i px py pt) 
	(setq sampleLen (xof (last samplepts)))
	(setq rpt (fix (/ x sampleLen))) ;tekrar miktarý
	(setq rptLen (* rpt sampleLen))
	(setq duzluk (* 0.5 (- x rptLen))) ;kenarlardaki düzlük paylarý
	
	(setq oldthick (getvar "THICKNESS"))
	(setvar "THICKNESS" z)
	(setlayer "CAB_DOORS" 7)

	(command "_POLYLINE")
	(command (list (/ X -2.0) 0.0))
	(command (list (/ X -2.0) (cm -1.8)))
	(setq lastx (+ (/ X -2.0) duzluk))  ;(cm  1.0)
	(setq lasty (cm -1.8))
	(setq i 0)
	(repeat rpt
		(foreach pt samplepts
			(setq px (+ (car pt) lastx (* i sampleLen)))
			(setq py (+ lasty (cadr pt)))
			(command (list px py))
		)
		(setq i (1+ i))
	)
	(command (list (/ X 2.0) (cm -1.8)))
	(command (list (/ X 2.0) 0.0))
	(command "_CLOSE")
	
	(setvar "THICKNESS" oldthick)
)

;LWPolyline noktalarýný USC'ye göre çevirip listeler
(defun plpts (pl / eget pair vrtx ptlist)
	(setq eget (entget pl))
	(foreach pair eget
		(if (equal 10 (car pair))
			(progn
				(setq vrtx (trans (cdr pair) 0 1))
				(setq ptlist (append ptlist (list vrtx)))
			)
		)
	)
	ptlist
)
