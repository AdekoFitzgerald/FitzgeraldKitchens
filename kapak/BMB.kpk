(defun BMB_Akanat (x z)
	(drawMeshKanat nil "ALU" x z
		(list
			(list "ALUMINIUM_FRAME"
				nil
				'(5 6 12 16 9 10 11 13 )
				'(2 7 4 15 1 8 3 14 )
				'(2 7 4 15 5 6 12 16 )
				'()
			)
			(list "CAB_DOORS"
				nil
				'(4 3 )
				'(1 2 )
				'(1 4 )
				'()
			)
)))
(defun BMB_Bkanat (x z)
