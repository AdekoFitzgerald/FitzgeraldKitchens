(defun CM05_Bkanat (x z)
	(drawMeshKanat nil "CAMKASA" x z
		(list
			(list "CAB_DOORS"
				(list (convertLength 0.0 5) 32 68 51 34)
				'(68 67 66 65 64 63 62 61 60 59 58 57 56 55 54 53 52 32 31 29 28 26 23 21 20 18 15 13 12 10 6 5 3 1 )
				'(51 50 49 48 47 46 45 44 43 42 41 40 39 38 37 36 35 34 33 30 27 25 24 22 19 17 16 14 11 9 8 7 4 2 )
				'(68 67 66 65 64 63 62 61 60 59 58 57 56 55 54 53 52 51 50 49 48 47 46 45 44 43 42 41 40 39 38 37 36 35 )
				'()
			)
		)
	)
	(setq ax (/2 x))
	(setq ara 5.8250)
	(setq pt1 -1.62638)
	(setq pt2 -1.02638)
	(setq boyB 20)
	;Dik
	(nokta+liste 	0.2  	pt1     ara)
	(nokta+liste 	-0.2  	pt1     ara)
	(nokta+liste 	-0.2  	pt1     (- z ara))
	(nokta+liste 	0.2  	pt1     (- z ara))
								 
	(nokta+liste 	0.8  	pt2     (+ ara 0.6))
	(nokta+liste 	-0.8  	pt2     (+ ara 0.6))
	(nokta+liste 	-0.8  	pt2     (- z ara 0.6))
	(nokta+liste 	0.8  	pt2     (- z ara 0.6))
	(dugum+liste (list
		2 3 4 1 "" 2 6 7 3 "" 1 4 8 5 "" 6 7 8 5 ""
	))
	(setlayer "CAB_DOORS" 7)
	(meshciz)
	(nokta+liste 	(+ (- ax )ara )  	pt1    (+ ara boyB))
	(nokta+liste 	(+ (- ax )ara )  	pt1    (+ ara boyB 0.4))
	(nokta+liste 	-0.2  				pt1    (+ ara boyB))
	(nokta+liste 	-0.2  				pt1    (+ ara boyB 0.4))
	(nokta+liste 	(+ (- ax )ara )  	pt2    (-(+ ara boyB)0.6))
	(nokta+liste 	(+ (- ax )ara )  	pt2    (+ ara boyB 0.8))
	(nokta+liste 	-0.8  				pt2    (-(+ ara boyB)0.6))
	(nokta+liste 	-0.8  				pt2    (+ ara boyB 0.8))
	(nokta+liste 	(+ (- ax )ara )  	pt1    (- z ara boyB))
	(nokta+liste 	(+ (- ax )ara )  	pt1    (- z ara boyB 0.4))
	(nokta+liste 	-0.2  				pt1    (- z ara boyB))
	(nokta+liste 	-0.2  				pt1    (- z ara boyB 0.4))
	(nokta+liste 	(+ (- ax )ara )  	pt2    (+(- z ara boyB)0.6))
	(nokta+liste 	(+ (- ax )ara )  	pt2    (- z ara boyB 0.8))
	(nokta+liste 	-0.8  				pt2    (+(- z ara boyB)0.6))
	(nokta+liste 	-0.8  				pt2    (- z ara boyB 0.8))
	(nokta+liste (-x 1 	0) nil nil)
	(nokta+liste (-x 2 	0) nil nil)
	(nokta+liste (-x 3 	0) nil nil)
	(nokta+liste (-x 4 	0) nil nil)
	(nokta+liste (-x 5 	0) nil nil)
	(nokta+liste (-x 6 	0) nil nil)
	(nokta+liste (-x 7 	0) nil nil)
	(nokta+liste (-x 8 	0) nil nil)
	(nokta+liste (-x 9 	0) nil nil)
	(nokta+liste (-x 10 0) nil nil)
	(nokta+liste (-x 11	0) nil nil)
	(nokta+liste (-x 12 0) nil nil)
	(nokta+liste (-x 13 0) nil nil)
	(nokta+liste (-x 14 0) nil nil)
	(nokta+liste (-x 15	0) nil nil)
	(nokta+liste (-x 16	0) nil nil)
	
	(dugum+liste (list
		1 2 4 3 "" 2 6 8 4 "" 1 3 7 5 "" 6 8 7 5 ""
		10 9 11 12 "" 9 13 15 11 "" 14 10 12 16 "" 14 13 15 16 ""
		19 20 18 17 "" 20 24 22 18 "" 23 19 17 21 "" 23 24 22 21 ""
		28 27 25 26 "" 27 31 29 25 "" 32 28 26 30 "" 32 31 29 30 ""
	))
	(setlayer "CAB_DOORS" 7)
	(meshciz)
)