(defun CM07_Bkanat (x z)
	(drawMeshKanat nil "CAMKASA" x z
		(list
			(list "CAB_DOORS"
				(list (convertLength 0.0 5) 32 68 51 34)
				'(68 67 66 65 64 63 62 61 60 59 58 57 56 55 54 53 52 32 31 29 28 26 23 21 20 18 15 13 12 10 6 5 3 1 )
				'(51 50 49 48 47 46 45 44 43 42 41 40 39 38 37 36 35 34 33 30 27 25 24 22 19 17 16 14 11 9 8 7 4 2 )
				'(68 67 66 65 64 63 62 61 60 59 58 57 56 55 54 53 52 51 50 49 48 47 46 45 44 43 42 41 40 39 38 37 36 35 )
				'()
			)
		)
	)
	(setq p1 (list  (- 5.8250(/2 x))     0.0  5.8250))
	(setq p2 (list  (- x (/2 x)5.8250)   0.0  5.8250));Alt sağ
	(setq p3 (list  (- 5.8250(/2 x))     0.0  (- z 5.8250)))
	(setq zq (distance p1 p3))
	(setq xq (distance p1 p2))
	(defun Pyol(bname) (if (tblsearch "block" bname) bname (strcat ad_ADekoPath"Kapak\\" bname)))
	(cond 
		((< z 45)
			(command cmdINSERT (Pyol "HcamPro10_1") (list (- x x) (- 1.62638) (- z (/2 z))) "_XYZ"   (/ xq 63.35)  1.0 (/ zq 28.35) 0.0)
		)
		((< z 75)
			(command cmdINSERT (Pyol "HcamPro10_2") (list (- x x) (- 1.62638) (- z (/2 z))) "_XYZ"   (/ xq 28.35)  1.0 (/ zq 63.35) 0.0)
		)
		((< z 125)
			(command "_insert" (Pyol "HcamPro10_3") (list (- x x) (- 1.62638) (- z (/2 z))) "_XYZ"   (/ xq 28.35)  1.0 (/ zq 113.35) 0.0)
		)
		((< z 175)
			(command "_insert" (Pyol "HcamPro10_4") (list (- x x) (- 1.62638) (- z (/2 z))) "_XYZ"   (/ xq 28.35)  1.0 (/ zq 163.35) 0.0)
		)
		(T
			(command "_insert" (Pyol "HcamPro10_5") (list (- x x) (- 1.62638) (- z (/2 z))) "_XYZ"   (/ xq 28.35)  1.0 (/ zq 213.35) 0.0)
		)
    )
)