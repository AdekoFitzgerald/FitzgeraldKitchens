(defun CMKPK100_Bkanat (x z / adetX adetZ solalt sagust)
	(drawMeshKanat nil "GOBEKLIC" x z
		(list
			(list 1
				nil
				'(92 91 90 89 88 87 86 85 80 79 78 77 76 75 74 73 72 71 70 69 68 67 66 65 64 63 44 43 42 41 40 39 38 37 36 35 34 33 32 31 30 29 28 27 8 7 6 5 )
				'(96 95 94 93 84 83 82 81 62 61 60 59 58 57 56 55 54 53 52 51 50 49 48 47 46 45 26 25 24 23 22 21 20 19 18 17 16 15 14 13 12 11 10 9 4 3 2 1 )
				'(94 93 91 89 87 86 84 81 80 79 78 77 76 75 74 73 72 71 70 69 68 67 66 65 64 63 26 25 24 23 22 21 20 19 18 17 16 15 14 13 12 11 10 9 6 5 3 1 )
				'()
				'()
			)
			(list "CAB_DOOR_FRAMES"
				nil
				'(12 11 10 9 4 3 2 1 )
				'(16 15 14 13 8 7 6 5 )
				'(14 13 12 10 6 5 3 1 )
				'()
				'()
			)
			(list "CAB_DOOR_GLASS"
				nil
				'(4 3 2 1 )
				'(8 7 6 5 )
				'(6 5 4 2 )
				'()
				'()
			)
		)
	)
	(setq adetX (fix (/ x (cm2cu 20.0))))
	(setq adetZ (fix (/ z (cm2cu 26.0))))
	(setq solalt (list (cm2cu 5.5) (cm2cu 5.5)))
	(setq sagust (-pt (list x z) (list (cm2cu 5.5) (cm2cu 5.5))))
	
	(if (not (or (< adetX 1) (< adetZ 1)))
		(kapakHucreCiz solalt sagust adetX adetZ CMKPK100_hucre)
	)
)

(setq  GOBEKLICELL_DONOTOPTIMIZE_MESH T) ;mesh optimizasyonuna girmemeli
