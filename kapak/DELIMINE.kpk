)




(defun DELIMINE_Akanat (x z)
(setq Ta (cm 3.0) Sa (cm 3.0))
	(cond
	((< x 30.0) (DELIMINES_Akanat x z))
	((< z 65.0) (DELIMINES_Akanat x z))
	((< z 90.0) (DELIMINEA_Akanat x z))
    ((< z 260.0) (DELIMINEG_Akanat x z))
    (T (DELIMINES_Akanat x z))
	)
)





