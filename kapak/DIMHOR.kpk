(defun DIMHOR_Akanat (x z)
	(setq Ta (cm 2.9) Sa (cm 2.9))
	(cond
	((or (< x 9) (< z 10)) (DIMDUZ_Akanat x z))
    ((< X 11) (DIM10_Akanat x z))
    ((< X 16) (DIM15_Akanat x z))
    ((< X 21) (DIM20_Akanat x z))
    ((< X 31) (DIM30_Akanat x z))
    ((< X 36) (DIM35_Akanat x z))
    ((< X 41) (DIM40_Akanat x z))
    ((< X 46) (DIM45_Akanat x z))
    ((< X 51) (DIM50_Akanat x z))
    ((< X 61) (DIM60_Akanat x z))
    ((< X 66) (DIM65_Akanat x z))
    ((< X 71) (DIM70_Akanat x z))
    ((< X 76) (DIM75_Akanat x z))
    ((< X 81) (DIM80_Akanat x z))
    ((< X 91) (DIM90_Akanat x z))
    ((< X 96) (DIM95_Akanat x z))
    ((< X 101) (DIM100_Akanat x z))
    ((< X 106) (DIM105_Akanat x z))
    ((< X 111) (DIM110_Akanat x z))
    ((< X 121) (DIM120_Akanat x z))
    (T (DIMDUZ_Akanat x z))
	)
)

(defun DIMHOR_Bkanat (x z)
	(setq Ta (cm 2.9) Sa (cm 2.9))
	(drawMeshKanat nil "KK001C" x z
		(list
			(list "CAB_DOORS"
