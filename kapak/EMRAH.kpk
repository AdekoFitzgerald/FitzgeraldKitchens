(defun EMRAHDAR_Bkanat (x z)
	(drawMeshKanat nil "EMRAHDARC" x z
		(list
			(list "CAB_DOORS"
				nil
				'(107 106 105 104 103 102 101 100 99 98 97 96 81 80 79 78 68 67 66 65 64 63 62 61 60 59 58 57 56 54 52 50 48 46 44 42 40 38 36 34 32 30 28 27 26 25 24 23 22 21 20 19 8 7 4 2 )
