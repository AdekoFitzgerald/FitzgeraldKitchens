(defun GOKKER_Bkanat (x z)
	(setq Ta (cm 3.0) Sa (cm 3.0))
	(drawMeshKanat nil "GOKKERC" x z
		(list
			(list "CAB_DOORS"
				nil
				'(138 137 136 135 134 133 132 131 130 129 128 127 126 125 124 123 122 121 120 119 118 117 116 115 114 113 112 111 110 109 108 107 106 105 104 103 102 101 100 99 98 97 96 95 94 93 92 91 90 89 72 71 70 69 68 67 66 65 64 63 62 61 60 59 58 57 40 39 38 37 36 35 34 33 32 31 30 29 28 27 26 25 20 19 18 17 16 15 10 9 8 7 4 2 )
				'(188 187 186 185 184 183 182 181 180 179 178 177 176 175 174 173 172 171 170 169 168 167 166 165 164 163 162 161 160 159 158 157 156 155 154 153 152 151 150 149 148 147 146 145 144 143 142 141 140 139 88 87 86 85 84 83 82 81 80 79 78 77 76 75 74 73 56 55 54 53 52 51 50 49 48 47 46 45 44 43 42 41 24 23 22 21 14 13 12 11 6 5 3 1 )
				'(163 162 161 160 159 158 157 156 155 154 153 152 151 150 149 148 147 146 145 144 143 142 141 140 139 138 136 135 131 130 128 126 124 122 120 118 116 114 112 110 108 106 104 103 100 98 96 94 92 91 88 87 86 85 84 83 82 81 80 79 78 77 76 75 74 73 40 39 38 37 36 35 34 33 32 31 30 29 28 27 26 25 22 21 20 17 16 14 12 9 4 3 2 1 )
				'()
				'()
			)
			(list "CAB_DOOR_GLASS"
				nil
				'(8 7 3 1 )
				'(6 5 4 2 )
				'(4 3 2 1 )
				'()
				'()
			)
		)
	)
)

(defun GOKKER_Akanat (x z)
	(cond
	((< x 020.0) (ORTAKS_Akanat x z))
    ((< z 020.0) (ORTAKS_Akanat x z))
    (T (GOKKERD_Akanat x z))
	)
)
