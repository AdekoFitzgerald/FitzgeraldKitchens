(defun GRZ_Akanat (x z)
	(setq Ta (cm 4.0) Sa (cm 4.0))
	(drawMeshKanat nil "GRZ" x z
		(list
			(list "CAB_DOORS"
				nil
				'( 87 85 84 83 80 79 78 77 76 75 74 73 58 57 54 53 52 51 40 39 38 37 34 33 32 31 28 27 26 25 24 23 21 19 18 17 15 13 10 8 6 5 3 1 )
				'( 88 86 82 81 72 71 70 69 68 67 66 65 64 63 62 61 60 59 56 55 50 49 48 47 46 45 44 43 42 41 36 35 30 29 22 20 16 14 12 11 9 7 4 2 )
				'( 88 87 86 85 79 77 76 75 74 73 72 71 70 69 68 67 66 65 64 63 46 44 42 41 40 39 38 37 36 35 34 33 32 31 30 29 28 27 26 25 22 21 20 19 )
				'( )
			)
)))
 (defun GRZ_Bkanat (x z)
	(setq Ta (cm 4.0) Sa (cm 4.0))
	(drawMeshKanat nil "GRZC" x z
		(list
			(list "CAB_DOORS"
				(list (cm -0.5) 7 1 2 5)
				'( 87 85 84 83 80 79 78 77 76 75 74 73 60 59 56 55 54 53 42 41 40 39 36 35 34 33 30 29 28 27 26 25 23 21 18 16 14 13 11 9 8 7 3 1 )
				'( 88 86 82 81 72 71 70 69 68 67 66 65 64 63 62 61 58 57 52 51 50 49 48 47 46 45 44 43 38 37 32 31 24 22 20 19 17 15 12 10 6 5 4 2 )
				'( 88 87 86 85 79 77 76 75 74 73 72 71 70 69 68 67 66 65 64 63 48 46 44 43 42 41 40 39 38 37 36 35 34 33 32 31 30 29 28 27 4 3 2 1 )
				'( )
			)
)))


(defun GRZ_Ckanat (x z)
   (if (> z (cm 36))
		(GRZ_Akanat x z)
		(progn
			(drawMeshKanat nil "GRZS" x z
				(list
					(list "CAB_DOORS"
						nil
						'( 23 21 20 19 16 15 14 13 8 7 6 5 )
						'( 24 22 18 17 12 11 10 9 4 3 2 1 )
						'( 24 23 22 21 15 14 11 10 6 5 4 3 )
						'( )
					)
				)
			)
		)
	)
)
