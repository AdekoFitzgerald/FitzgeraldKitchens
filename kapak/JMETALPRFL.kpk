(setq JMETALPRFL_Bkanat_DONOTOPTIMIZE T)
(defun JMETALPRFL_Bkanat (x z)
	(cond 
		((member kulp '("0-")) (P0004DUZ_Bkanat x z))
		((member kulp '("D-")) (P00D4_Bkanat x z))
		(T (P0004_Bkanat x z))
	)
)
