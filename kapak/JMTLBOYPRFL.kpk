(setq JMTLBOYPRFL_Bkanat_DONOTOPTIMIZE T)
(defun JMTLBOYPRFL_Bkanat (x z)
	(cond 
		((member kulp '("0-" )) (JDUZ_Bkanat x z))
		((member kulp '("KD" "GD" "D-" )) (JYAN_Bkanat x z))
		((member kulp '("G-" "K-")) (JUST_Bkanat x z))
		(T (JUST_Bkanat x z))
	)
)
