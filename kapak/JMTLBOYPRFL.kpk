(defun JDUZ_Bkanat (x z)
	(drawMeshKanat nil "JDUZC" x z
		(list
			(list "CAB_DOORS"
				nil
				'(66 65 64 63 62 61 60 59 38 37 36 35 34 33 32 31 30 29 28 27 26 25 22 21 19 18 16 15 10 9 4 3 2 1 )
				'(68 67 58 57 56 55 54 53 52 51 50 49 48 47 46 45 44 43 42 41 40 39 24 23 20 17 14 13 12 11 8 7 6 5 )
				'(68 65 64 63 62 61 60 59 58 57 56 55 54 53 52 51 50 49 38 37 35 34 20 19 18 17 16 14 12 9 6 5 3 1 )
				'()
				'()
			)
			(list "CAB_DOOR_GLASS"
				nil
				'(4 3 2 1 )
				'(8 7 6 5 )
				'(6 5 4 2 )
				'()
				'()
			)
		)
	)
)

