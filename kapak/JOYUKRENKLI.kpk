(setq JOYUKRENKLI_Akanat_DONOTOPTIMIZE T)
(defun JOYUKRENKLI_Akanat (x z)
	(cond 
		((member kulp '("0-")) (PDUZ_Akanat x z))
		((member kulp '("D-")) (PYAN_Akanat x z))
		(T (PUST_Akanat x z))
	)
)



