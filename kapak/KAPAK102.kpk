(defun KAPAK102_Akanat (x z)
	(setq Ta (cm 3.6) Sa (cm 3.6))
	(cond
	((< x 12.0) (KAPAK102AS_Akanat x z))
	((< z 12.0) (KAPAK102AS_Akanat x z))
	
	((< x 18.0) (KAPAK102AD_Akanat x z))
    ((< z 18.0) (KAPAK102AY_Akanat x z))
   
    (T (KAPAK102A_Akanat x z))
	)
)









