(defun KK004_Akanat (x z)
	(setq Ta (cm 2.5) Sa (cm 2.5))
	(cond
	((< x 25.0) (KK004DAR_Akanat x z))
    ((< Z 25.0) (KK004DAR_Akanat x z))
    ((< X 35)   (KK004ARA_Akanat x z))
    ((< Z 35)   (KK004ARA_Akanat x z))
    (T (KK004GNL_Akanat x z))
	)
)


