(defun KODCAM12_Bkanat (x z)
	(drawMeshKanat "KODCAM" x z
		(list
			(list "CAB_DOORS"
				nil
				'(86 85 84 83 82 81 80 79 78 77 76 75 74 73 72 71 70 69 68 67 66 65 64 63 62 61 60 59 58 57 56 55 54 53 52 49 48 47 46 45 44 43 42 41 40 39 28 27 26 25 24 23 22 21 20 19 4 3 2 1 )
				'(120 119 118 117 116 115 114 113 112 111 110 109 108 107 106 105 104 103 102 101 100 99 98 97 96 95 94 93 92 91 90 89 88 87 51 50 38 37 36 35 34 33 32 31 30 29 18 17 16 15 14 13 12 11 10 9 8 7 6 5 )
				'(103 102 101 100 99 98 97 96 95 94 93 92 91 90 89 88 87 86 84 82 80 78 77 74 73 70 68 66 64 62 61 58 56 54 52 51 48 47 46 45 44 43 42 41 40 39 18 17 16 15 14 13 12 11 10 9 6 5 3 1 )
				'()
				'()
			)
			(list "CAB_DOOR_GLASS"
				nil
				'(8 6 4 2 )
				'(7 5 3 1 )
				'(8 7 2 1 )
				'()
				'()
			)
			(list "CAB_DOOR_GLASS"
				nil
				'(8 6 4 2 )
				'(7 5 3 1 )
				'(8 7 2 1 )
				'()
				'()
			)
		)
	)
	(drawBars x z (cm 6.0) KODCAM12_profil KODCAM12_xtiers KODCAM12_ztiers)
)

(setq KODCAM12_profil (mapcar '(lambda (pt) (mapcar 'cm pt)) '((-1.0 0.8) (1.0 0.8) (1.0 1.0) (0.944773 1.12239) (0.85232 1.21976) (0.732956 1.28125) (0.6 1.3) (-0.6 1.3) (-0.732956 1.28125) (-0.85232 1.21976) (-0.944773 1.12239) (-1.0 1.0))))
(setq KODCAM12_xtiers 2)
(setq KODCAM12_ztiers 3)





;;; ___----____ Kapak çýtalarý ile ilgili ADeko 22 de kaldýrýlmalý  ___----____
(defun drawBars (x z ft profile xSteps zSteps / fromEnt xL xR i)
	(setq fromEnt (entlast))
	
	(setq xL (- ft (/2 x)))
	(setq xR (* -1 xL))

	(if (equal 'INT (type xSteps))
		(setq i xSteps)
		(progn
			(setq i 1)
			(while (< 1 (/ x (nth (1- i) xSteps))) (i++))
		)
	)
	; i is number of dividents not deviders 
	; eg. if you want to put 1 profil you should set i = 2;
	(profilDikey i ft)
	
	(if (equal 'INT (type zSteps))
		(setq i zSteps)
		(progn
			(setq i 1)
			(while (< 1 (/ z (nth (1- i) zSteps))) (i++))
		)
	)
	; same as above
	(profilYatay i ft)

	(setq selset (collectMents fromEnt))
	(if (and selset (setq sslen (sslength selset)) (not (zerop sslen)))
		(command "_.ROTATE3D" selset "" "_X" '(0 0) 90)
	)
)

