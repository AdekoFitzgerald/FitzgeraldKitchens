(defun KUMEYE_Akanat (x z)
(setq Ta (cm 3.0) Sa (cm 3.0))
	(cond
		((< X 09) (KUMEYEDUZ_Akanat x z))
		((< X 11) (KUMEYE10_Akanat x z))
		((< X 16) (KUMEYE15_Akanat x z))
		((< X 21) (KUMEYE20_Akanat x z))
		((< X 26) (KUMEYE25_Akanat x z))
		((< X 31) (KUMEYE30_Akanat x z))
		((< X 36) (KUMEYE35_Akanat x z))
		((< X 38) (KUMEYE37_Akanat x z))
		((< X 41) (KUMEYE40_Akanat x z))
		((< X 43) (KUMEYE42_Akanat x z))
		((< X 46) (KUMEYE45_Akanat x z))
		((< X 48) (KUMEYE47_Akanat x z))
		((< X 51) (KUMEYE50_Akanat x z))
		((< X 56) (KUMEYE55_Akanat x z))
		((< X 61) (KUMEYE60_Akanat x z))
		((< X 66) (KUMEYE65_Akanat x z))
		((< X 71) (KUMEYE70_Akanat x z))
		((< X 76) (KUMEYE75_Akanat x z))
		((< X 81) (KUMEYE80_Akanat x z))
		((< X 86) (KUMEYE85_Akanat x z))
		((< X 91) (KUMEYE90_Akanat x z))
		((< X 96) (KUMEYE95_Akanat x z))
		((< X 101) (KUMEYE100_Akanat x z))
		((< X 106) (KUMEYE105_Akanat x z))
		((< X 111) (KUMEYE110_Akanat x z))
		((< X 116) (KUMEYE115_Akanat x z))
		((< X 121) (KUMEYE120_Akanat x z))
		(T (KUMEYEDUZ_Akanat x z))
	)
)




(defun KUMEYE_Bkanat (x z)
