(setq LBOYPRFL_Bkanat_DONOTOPTIMIZE T)
(defun LBOYPRFL_Bkanat (x z)
	(cond 
		((member kulp '("0-")) (LDUZ_Bkanat x z))
		((member kulp '("D-")) (LYAN_Bkanat x z))
		(T (LUST_Bkanat x z))
	)
)



