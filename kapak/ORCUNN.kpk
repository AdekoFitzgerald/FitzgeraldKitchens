(defun ORCUNN_Bkanat (x z)
(setq Ta (cm 3.0) Sa (cm 3.0))
	(setq Ta (cm 3.0) Sa (cm 3.0))
	(drawMeshKanat nil "ORCUNNC" x z
		(list
			(list "CAB_DOORS"
