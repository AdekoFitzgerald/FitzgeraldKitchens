(defun PANJUR_Akanat (x z)
	(setq Ta (cm 4.0) Sa (cm 4.0))
	(cond
	((or (< x 29) (< z 29)) (PANDUZ_Akanat x z))
    ((< Z 31) (PAN30_Akanat x z))
    ((< Z 37) (PAN36_Akanat x z))
    ((< Z 43) (PAN40_Akanat x z))
    ((< Z 50) (PAN45_Akanat x z))
    ((< Z 54) (PAN50_Akanat x z))
    ((< Z 57) (PAN54_Akanat x z))
    ((< Z 64) (PAN60_Akanat x z))
    ((< Z 71) (PAN70_Akanat x z))
    ((< Z 76) (PAN72_Akanat x z))
    ((< Z 84) (PAN80_Akanat x z))
    ((< Z 94) (PAN90_Akanat x z))
    ((< Z 101) (PAN100_Akanat x z))
    ((< Z 111) (PAN110_Akanat x z))
    ((< Z 121) (PAN120_Akanat x z))
    ((< Z 131) (PAN130_Akanat x z))
    ((< Z 141) (PAN140_Akanat x z))
    ((< Z 151) (PAN150_Akanat x z))
    ((< Z 161) (PAN160_Akanat x z))
    ((< Z 171) (PAN170_Akanat x z))
    ((< Z 181) (PAN180_Akanat x z))
    ((< Z 191) (PAN190_Akanat x z))
    ((< Z 201) (PAN200_Akanat x z))
    ((< Z 211) (PAN210_Akanat x z))
    ((< Z 221) (PAN220_Akanat x z))
    ((< Z 231) (PAN230_Akanat x z))
    ((< Z 241) (PAN240_Akanat x z))
    ((< Z 251) (PAN250_Akanat x z))
    ((< Z 261) (PAN260_Akanat x z))
	)
)

