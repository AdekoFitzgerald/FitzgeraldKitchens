(defun RKpk_Akanat (x z)
	(if (> z 220)
		(progn
			(drawMeshKanat nil "RKpk" x z
				(list
					(list "CAB_DOORS"
						nil
						'( 24 22 20 18 16 14 12 10 8 6 4 2 )
						'( 23 21 19 17 15 13 11 9 7 5 3 1 )
						'( 8 7 2 1 )
						'( )
					)
					(list "CAB_DOOR_FRAMES"
						nil
						'( 136 107 106 105 104 103 102 101 100 99 98 97 96 95 94 93 92 91 90 89 88 87 86 85 84 83 82 81 80 79 76 73 70 69 67 66 65 64 63 61 60 54 53 50 47 44 43 41 40 39 38 37 35 34 28 27 24 21 18 17 15 14 13 12 11 9 8 7 )
						'( 135 134 133 132 131 130 129 128 127 126 125 124 123 122 121 120 119 118 117 116 115 114 113 112 111 110 109 108 78 77 75 74 72 71 68 62 59 58 57 56 55 52 51 49 48 46 45 42 36 33 32 31 30 29 26 25 23 22 20 19 16 10 6 5 4 3 2 1 )
						'( 136 135 134 133 132 131 130 129 128 127 120 118 117 114 113 112 111 110 109 108 107 105 104 102 101 98 96 95 91 90 89 87 86 85 84 83 82 81 80 79 78 77 )
						'( )
					)
				)
			)
		)
        (progn
             (DUZKPK_Akanat x z)
        )
    )
)

(defun RKpk_Bkanat (x z)
	(drawMeshKanat nil "ALUC" x z
		(list
			(list "ALUMINIUM_FRAME"
				(list (cm 0.2) 14 16 15 13)
				'(8 7 19 23 12 16 9 10 22 18 11 14 )
				'(2 6 20 4 15 24 1 5 17 3 13 21 )
				'(2 6 20 4 15 24 8 7 19 23 12 16 )
				'()
			)
		)
	)
)

(defun RKpk_Ckanat (x z)
      (RKpk_Akanat  x z)
)

