(defun S1_Akanat (x z)	
	(drawMeshKanat nil "S1" x z
		(list
			(list "CAB_DOORS"
				nil
				'( 104 102 101 98 97 94 70 69 68 67 66 65 64 63 62 61 60 59 58 57 56 55 54 53 52 51 50 49 48 47 46 45 44 38 37 36 35 30 29 28 27 26 25 24 23 7 6 5 4 3 2 1 )
				'( 103 100 99 96 95 93 92 91 90 89 88 87 86 85 84 83 82 81 80 79 78 77 76 75 74 73 72 71 43 42 41 40 39 34 33 32 31 22 21 20 19 18 17 16 15 14 13 12 11 10 9 8 )
				'( 104 103 102 101 100 99 92 91 90 89 88 87 86 85 84 83 81 70 69 68 67 66 65 64 63 62 61 59 45 30 29 28 27 26 25 24 23 22 21 20 19 18 17 16 15 14 13 12 11 3 2 1 )
				'( )
			)
		)
	)
)

(defun S1_Bkanat (x z)
    (drawMeshKanat nil "ALUC" x z
		(list
			(list "ALUMINIUM_FRAME"
				(list (cm 0.2) 14 16 15 13)
				'(8 7 19 23 12 16 9 10 22 18 11 14 )
				'(2 6 20 4 15 24 1 5 17 3 13 21 )
				'(2 6 20 4 15 24 8 7 19 23 12 16 )
				'()
			)
		)
	)
)

(defun S1_Ckanat (x z)
	(S1_Akanat x z)
)
 
