		(list
			(list "CAB_DOORS"
				(list (cm -0.5) 72 151 139 71)
				'( 216 215 214 213 209 179 178 177 176 175 174 173 172 171 170 169 168 167 166 165 164 163 162 161 160 159 158 157 156 155 154 153 152 151 146 145 144 143 142 138 137 136 135 134 133 132 123 122 121 120 119 118 117 116 107 106 105 104 103 102 101 100 91 90 89 88 87 86 85 84 74 73 72 65 64 63 62 61 60 59 58 57 56 55 54 53 52 51 50 49 48 47 46 45 44 43 42 41 40 39 38 37 36 35 34 33 32 31 )
