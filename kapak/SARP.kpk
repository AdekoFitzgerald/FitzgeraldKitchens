(defun SARP_Akanat (x z)
	(setq Ta (cm 2.5) Sa (cm 2.5))
	(if (or ( < z (cm 25))( < x (cm 25)))
		(DUZKPK_Akanat x z)
		(progn
			(drawMeshKanat nil "SARP" x z
				(list
					(list "CAB_DOORS"
						nil
						'( 288 287 286 285 284 283 282 281 280 271 270 269 268 267 266 265 264 255 254 253 252 251 250 249 248 239 238 237 236 235 234 233 232 222 221 220 219 218 217 216 215 205 204 203 202 201 200 199 198 189 188 187 186 185 184 183 182 173 172 171 170 169 168 167 166 157 149 146 145 144 143 142 137 134 133 132 131 130 129 123 122 121 120 119 118 117 116 115 109 108 102 101 100 99 98 97 96 95 86 85 84 83 82 81 80 79 78 77 76 75 74 73 72 71 70 69 58 57 56 55 54 53 52 51 44 43 42 41 40 39 38 37 36 35 22 21 18 14 13 12 11 10 9 8 )
