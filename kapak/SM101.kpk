(defun SM101_Bkanat (x z)
	(drawMeshKanat nil "SM101C" x z
		(list
			(list "CAB_DOORS"
				nil
				'(212 211 210 209 208 207 206 205 204 203 202 201 200 199 198 197 196 193 170 169 168 167 166 165 164 163 162 161 160 159 158 157 156 155 154 153 152 151 150 149 148 147 146 145 144 143 142 141 109 108 107 106 105 104 103 101 97 96 94 93 91 89 87 86 78 77 74 73 70 69 68 67 66 65 64 63 62 61 60 59 58 57 56 55 54 53 52 51 50 49 48 47 46 45 44 43 42 39 38 35 34 33 8 7 6 5 )
