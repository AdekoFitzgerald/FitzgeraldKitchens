						'()
					)
				)
			)
		)
	)
)	

(defun SM111_Bkanat (x z)
	(drawDoorHitbox)
	(drawMeshKanat nil "SM111C" x z
		(list
			(list "CAB_DOORS"
				(list (convertLength -0.5 5) 6 8 4 3)
				'(68 67 66 65 64 63 62 61 60 59 58 57 56 55 54 53 52 51 50 49 48 37 35 34 33 23 22 21 20 19 8 7 6 5 )
				'(47 46 45 44 43 42 41 40 39 38 36 32 31 30 29 28 27 26 25 24 18 17 16 15 14 13 12 11 10 9 4 3 2 1 )
				'(68 67 66 65 64 57 56 55 54 53 52 51 50 49 48 47 46 45 44 43 42 41 40 39 38 17 15 14 12 9 8 7 4 2 )
				'()
			)
		)
		(list
			(list "CAB_DOOR_GLASS"
				nil
				'(4 3 2 1 )
				'(8 7 6 5 )
				'(6 5 4 2 )
				'()
				'()
			)
		)
	)
)
