				'(128 127 126 125 124 123 122 121 120 118 116 89 88 87 86 85 84 83 82 81 80 79 78 77 76 75 60 59 58 57 56 55 54 53 52 51 50 49 48 47 46 45 44 43 42 41 40 39 38 37 36 25 23 22 20 17 15 14 12 9 6 5 3 1 )
				'()
			)
		)
		(list
			(list "CAB_DOOR_GLASS"
				nil
				'(4 3 2 1 )
				'(8 7 6 5 )
				'(6 5 4 2 )
				'()
				'()
			)
