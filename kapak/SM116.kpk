(defun SM116_Akanat (x z)
	(cond
		(	(or (< z (convertLength 17 5)) (< x (convertLength 17 5)))
			(drawMeshKanat nil "SM100" x z
			(list
				(list "CAB_DOORS"
					nil
					'(149 148 147 146 145 144 143 142 141 140 139 138 137 136 135 134 133 132 131 130 129 128 127 126 125 124 123 122 121 120 119 118 117 116 115 114 113 112 111 110 109 108 107 106 105 104 103 102 101 100 99 98 97 96 95 94 93 92 91 90 89 88 87 86 85 84 83 82 81 80 79 78 77 76 75 70 69 68 67 66 65 64 63 62 61 60 59 58 57 56 55 54 53 52 51 50 49 48 47 46 45 44 43 42 41 40 39 38 37 )
