(defun SM118_Akanat (x z)	
	(cond
	((< x (convertLength 24 5))  (SM11815_Akanat x z))
	((< x (convertLength 26 5))  (SM11825_Akanat x z))
	((< x (convertLength 31 5))  (SM11830_Akanat x z))
	((< x (convertLength 36 5))  (SM11835_Akanat x z))
	((< x (convertLength 41 5))  (SM11840_Akanat x z))
	((< x (convertLength 46 5))  (SM11845_Akanat x z))
	((< x (convertLength 51 5))  (SM11850_Akanat x z))
	((< x (convertLength 56 5))  (SM11855_Akanat x z))
	((< x (convertLength 61 5))  (SM11860_Akanat x z))
	((< x (convertLength 71 5))  (SM11870_Akanat x z))
	((< x (convertLength 81 5))  (SM11880_Akanat x z))
	((< x (convertLength 91 5))  (SM11890_Akanat x z))
	((< x (convertLength 101 5)) (SM118100_Akanat x z))
	)
)

