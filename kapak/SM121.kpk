					(list "CAB_DOORS"
						nil
						'(60 59 58 57 56 55 46 45 44 33 32 31 30 27 26 21 20 19 18 17 16 15 14 13 11 9 8 7 4 3 )
						'(54 53 52 51 50 49 48 47 43 42 41 40 39 38 37 36 35 34 29 28 25 24 23 22 12 10 6 5 2 1 )
						'(60 59 58 57 56 55 54 53 51 50 48 47 45 44 43 42 40 38 36 34 33 32 31 30 12 11 7 5 4 2 )
						'()
					)
				)
			)
		)
		( T
			(drawMeshKanat nil "SM121" x z
				(list
					(list "CAB_DOORS"
						nil
						'(72 71 70 69 68 67 66 65 64 63 62 61 60 59 58 57 56 55 54 53 50 49 48 47 46 45 44 43 34 33 32 21 20 19 18 15 14 9 8 7 6 5 4 3 2 1 )
						'(92 91 90 89 88 87 86 85 84 83 82 81 80 79 78 77 76 75 74 73 52 51 42 41 40 39 38 37 36 35 31 30 29 28 27 26 25 24 23 22 17 16 13 12 11 10 )
						'(82 81 80 79 78 77 76 75 74 73 72 71 70 69 68 67 66 65 64 63 51 50 48 47 46 45 44 43 42 41 39 38 36 35 33 32 31 30 28 26 24 22 21 20 19 18 )
						'()
