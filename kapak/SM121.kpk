)
	
(defun SM121_Bkanat (x z)
	(drawMeshKanat nil "SM121C" x z
		(list
			(list "CAB_DOORS"
				nil
				'(56 55 54 53 52 51 42 41 40 34 33 32 31 23 22 17 16 15 14 13 12 11 10 9 8 7 6 5 )
				'(50 49 48 47 46 45 44 43 39 38 37 36 35 30 29 28 27 26 25 24 21 20 19 18 4 3 2 1 )
				'(56 55 54 53 52 51 50 49 47 46 44 43 41 40 39 38 34 33 32 31 30 29 28 27 6 5 3 1 )
				'()
			)
		)
		(list
			(list "CAB_DOOR_GLASS"
				nil
				'(4 3 2 1 )
				'(8 7 6 5 )
				'(6 5 4 2 )
				'()
				'()
			)
		)
	)
)
