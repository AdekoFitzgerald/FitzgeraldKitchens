		)
		
	)
)

(defun SM128_Bkanat (x z)
	(drawMeshKanat nil "SM128CK" x z
		(list
			(list "CAB_DOORS"
				nil
				'(48 47 46 43 40 39 38 35 30 29 28 26 23 21 20 19 18 17 16 15 8 7 6 5 )
				'(45 44 42 41 37 36 34 33 32 31 27 25 24 22 14 13 12 11 10 9 4 3 2 1 )
				'(48 47 44 43 42 38 37 33 32 31 30 29 24 23 20 18 16 14 12 10 8 7 4 2 )
				'()
			)
		)
		(list
			(list "CAB_DOOR_GLASS"
				nil
				'(4 3 2 1 )
				'(8 7 6 5 )
				'(6 5 4 2 )
				'()
				'()
			)
		)
	)
)