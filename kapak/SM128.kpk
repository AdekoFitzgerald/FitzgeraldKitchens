(defun SM128_Akanat (x z)
	(cond
		(	(< z (cm 12))
			(drawMeshKanat nil "SM128FAK" x z
				(list
					(list "CAB_DOORS"
						nil
						'(124 122 120 118 116 114 112 110 109 108 107 106 105 104 103 102 99 98 95 93 92 89 88 86 84 82 80 78 76 74 72 70 68 66 64 62 60 57 56 53 51 50 47 46 44 42 40 38 36 34 32 30 19 18 15 14 12 9 8 5 3 1 )
						'(123 121 119 117 115 113 111 101 100 97 96 94 91 90 87 85 83 81 79 77 75 73 71 69 67 65 63 61 59 58 55 54 52 49 48 45 43 41 39 37 35 33 31 29 28 27 26 25 24 23 22 21 20 17 16 13 11 10 7 6 4 2 )
						'(72 71 70 69 68 67 66 65 64 63 62 61 60 59 58 57 56 55 54 53 52 51 50 49 48 47 46 45 44 43 42 41 40 39 38 37 36 35 34 33 32 31 30 29 20 19 18 17 16 15 14 13 12 11 10 9 8 7 6 5 4 3 )
						'()
						'()
					)
				)
			)
		)

		(	(< z (cm 20))
			(drawMeshKanat nil "SM128CKMC" x z
				(list
					(list "CAB_DOORS"
						nil
						'(60 59 58 55 52 48 47 46 45 44 38 36 35 34 32 31 30 29 28 27 18 17 14 13 11 9 7 6 4 2 )
						'(57 56 54 53 51 50 49 43 42 41 40 39 37 33 26 25 24 23 22 21 20 19 16 15 12 10 8 5 3 1 )
						'(60 59 56 54 49 48 45 44 42 40 39 38 34 33 31 29 27 26 24 22 19 18 15 14 12 11 10 9 8 7 )
						'()
						'()
					)
				)
			)
		)

		(	(< x (cm 20))
			(drawMeshKanat nil "SM128DK" x z
				(list
					(list "CAB_DOORS"
						nil
						'(58 57 55 53 52 51 50 47 46 43 41 37 36 35 32 30 28 25 23 21 20 17 16 13 6 5 4 3 2 1 )
						'(60 59 56 54 49 48 45 44 42 40 39 38 34 33 31 29 27 26 24 22 19 18 15 14 12 11 10 9 8 7 )
						'(60 59 58 55 52 48 47 46 45 44 38 36 35 34 32 31 30 29 28 27 18 17 14 13 11 9 7 6 4 2 )
						'()
						'()
					)
				)
			)
		)
	
		(	T
			(drawMeshKanat nil "SM128" x z
				(list
					(list "CAB_DOORS"
						nil
						'(60 59 58 55 52 51 50 47 42 41 40 38 35 33 32 31 30 29 28 27 18 17 16 15 12 10 8 5 3 1 )
						'(57 56 54 53 49 48 46 45 44 43 39 37 36 34 26 25 24 23 22 21 20 19 14 13 11 9 7 6 4 2 )
						'(60 59 56 55 54 50 49 45 44 43 42 41 36 35 32 30 28 26 24 22 19 18 16 13 6 5 4 3 2 1 )
						'()
