(defun SM189_Akanat (x z)	
	(cond
	((< z (convertLength 31 5))  (SM100_Akanat x z))
	((< z (convertLength 33 5))  (SM18932_Akanat x z))
	((< z (convertLength 37 5))  (SM18936_Akanat x z))
	((< z (convertLength 46 5))  (SM18945_Akanat x z))
	((< z (convertLength 54 5))  (SM18953_Akanat x z))
	((< z (convertLength 72 5))  (SM18971_Akanat x z))
	((< z (convertLength 73 5))  (SM18972_Akanat x z))
	((< z (convertLength 91 5))  (SM18990_Akanat x z))
	((< z (convertLength 133 5)) (SM189132_Akanat x z))
	)
)

