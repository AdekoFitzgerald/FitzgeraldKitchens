(defun SM203_Bkanat (x z)
	(drawMeshKanat nil "SM203CK" x z
		(list
			(list "CAB_DOORS"
						nil
						'(120 119 114 113 64 63 62 61 60 59 58 57 56 55 54 53 52 51 50 49 48 47 46 45 44 43 42 41 40 39 38 37 36 35 34 33 32 31 30 29 28 27 26 25 24 23 22 21 20 19 18 17 15 13 8 7 6 5 4 3 )
						'(118 117 116 115 112 111 110 109 108 107 106 105 104 103 102 101 100 99 98 97 96 95 94 93 92 91 90 89 88 87 86 85 84 83 82 81 80 79 78 77 76 75 74 73 72 71 70 69 68 67 66 65 16 14 12 11 10 9 2 1 )
						'(119 117 115 113 112 111 110 109 108 107 106 105 104 103 102 101 100 99 98 97 96 95 94 93 92 91 90 89 64 62 60 57 55 54 52 49 47 46 44 42 39 37 36 34 32 29 27 26 24 21 19 18 16 15 11 7 4 3 2 1 )
						'()
						'()
			)
			(list "CAB_DOOR_GLASS"
				nil
				'(8 6 4 2 )
				'(7 5 3 1 )
				'(8 7 2 1 )
				'()
				'()
			)
		)	
	)
)