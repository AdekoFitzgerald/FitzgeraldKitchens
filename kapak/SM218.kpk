(defun SM218_Akanat (x z)	
	(cond
	((< z (convertLength 31 5))  (SM100_Akanat x z))
	((< z (convertLength 33 5))  (SM21832_Akanat x z))
	((< z (convertLength 37 5))  (SM21836_Akanat x z))
	((< z (convertLength 46 5))  (SM21845_Akanat x z))
	((< z (convertLength 54 5))  (SM21853_Akanat x z))
	((< z (convertLength 72 5))  (SM21871_Akanat x z))
	((< z (convertLength 73 5))  (SM21872_Akanat x z))
	((< z (convertLength 91 5))  (SM21890_Akanat x z))
	((< z (convertLength 133 5)) (SM218132_Akanat x z))
	)
)

(defun SM218_Bkanat (x z)		
