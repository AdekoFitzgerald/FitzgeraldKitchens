(defun SM222_Bkanat (x z)

	(drawMeshKanat nil "SM222CK" x z
		(list
			(list "CAB_DOORS"
				nil
				'(71 70 67 64 62 60 55 54 53 52 51 50 45 44 43 41 40 39 38 37 36 35 34 33 32 31 30 29 28 27 26 25 24 23 22 21 )
