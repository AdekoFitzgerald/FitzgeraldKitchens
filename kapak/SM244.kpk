		(list
			(list "CAB_DOORS"
				nil
				'(34 33 30 29 26 25 24 23 20 17 14 13 12 11 6 5 4 3 )
				'(36 35 32 31 28 27 22 21 19 18 16 15 10 9 8 7 2 1 )
				'(32 31 30 29 28 27 26 25 18 17 12 11 10 9 4 3 2 1 )
				'()
				'()
			)
			(list "CAB_DOOR_GLASS"
				nil
				'(8 6 4 2 )
				'(7 5 3 1 )
				'(8 7 2 1 )
				'()
				'()
			)
		)	
	)
)