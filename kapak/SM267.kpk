(defun SM267_Bkanat (x z)

	(drawMeshKanat nil "SM267CK" x z
		(list
			(list "CAB_DOORS"
				nil
				'(103 102 100 99 98 97 96 95 94 93 92 91 90 89 88 87 86 85 84 83 62 61 55 54 53 52 50 49 46 45 44 40 39 35 34 33 28 27 26 25 24 23 18 17 16 15 14 13 12 11 6 5 )
				'(104 101 82 81 80 79 78 77 76 75 74 73 72 71 70 69 68 67 66 65 64 63 60 59 58 57 56 51 48 47 43 42 41 38 37 36 32 31 30 29 22 21 20 19 10 9 8 7 4 3 2 1 )
				'(102 101 100 98 95 93 92 90 87 85 83 81 79 78 76 73 71 70 68 65 64 62 60 59 55 54 51 49 48 46 42 41 40 39 31 27 24 23 22 21 20 17 16 15 10 8 6 5 3 1 )
				'()
				'()
