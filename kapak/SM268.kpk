(defun SM268_Bkanat (x z)
	(drawMeshKanat nil "SM268CK" x z
		(list
			(list "CAB_DOORS"
				nil
				'(87 86 84 83 82 81 80 79 78 77 76 75 74 73 72 71 70 69 68 67 46 45 39 38 37 36 34 33 31 30 26 25 24 20 19 15 14 13 8 7 6 5 4 3 )
				'(88 85 66 65 64 63 62 61 60 59 58 57 56 55 54 53 52 51 50 49 48 47 44 43 42 41 40 35 32 29 28 27 23 22 21 18 17 16 12 11 10 9 2 1 )
				'(86 85 84 82 79 77 76 74 71 69 67 65 63 62 60 57 55 54 52 49 48 46 44 43 39 38 35 33 30 29 28 26 22 21 20 19 11 7 4 3 2 1 )
				'()
				'()
			)
			(list "CAB_DOOR_GLASS"
				nil
				'(8 6 4 2 )
				'(7 5 3 1 )
				'(8 7 2 1 )
				'()
				'()
