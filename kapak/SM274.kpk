			(list "CAB_DOORS"
				nil
				'(34 33 32 30 26 25 20 19 18 17 14 13 8 7 6 5 4 3 )
				'(36 35 31 29 28 27 24 23 22 21 16 15 12 11 10 9 2 1 )
				'(36 33 30 29 28 25 24 23 18 17 15 13 11 7 4 3 2 1 )
				'()
				'()
			)
			(list "CAB_DOOR_GLASS"
				nil
				'(8 6 4 2 )
				'(7 5 3 1 )
				'(8 7 2 1 )
				'()
				'()
			)
		)	
	)
)