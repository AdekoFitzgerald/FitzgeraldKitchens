				(drawMeshKanat nil "TEMPDUZ" x z
					(list
						(list "CAB_DOORS"
							nil
							'(46 45 44 43 42 41 40 39 38 37 36 35 24 23 22 21 20 19 18 17 16 15 4 2 )
							'(48 47 34 33 32 31 30 29 28 27 26 25 14 13 12 11 10 9 8 7 6 5 3 1 )
							'(47 46 34 33 32 31 30 29 28 27 26 25 24 23 22 21 20 19 18 17 16 15 2 1 )
							'()
						)
					)
				)
			)
		(T
			(drawMeshKanat nil "TEMP300" x z
