(defun YAYYYY_Bkanat (x z / adetX adetZ solalt sagust)
	(drawMeshKanat nil "BUXXKAPAK" x z
		(list
			(list 1
				nil
				'(84 83 82 81 80 79 78 77 76 75 74 73 72 71 70 69 68 67 66 65 64 63 62 61 60 59 58 57 56 45 44 43 42 41 40 39 38 37 36 35 34 33 32 31 30 29 28 27 26 15 10 9 4 3 2 1 )
				'(112 111 110 109 108 107 106 105 104 103 102 101 100 99 98 97 96 95 94 93 92 91 90 89 88 87 86 85 55 54 53 52 51 50 49 48 47 46 25 24 23 22 21 20 19 18 17 16 14 13 12 11 8 7 6 5 )
				'(98 97 96 95 94 93 92 91 90 89 88 87 86 85 84 82 80 79 76 74 72 70 68 67 64 62 60 59 58 55 54 53 52 51 50 49 48 47 46 45 44 43 42 41 40 39 38 37 36 14 12 10 6 5 3 1 )
				'()
				'()
			)
			(list "CAB_DOOR_GLASS"
				nil
				'(4 3 2 1 )
				'(8 7 6 5 )
				'(6 5 4 2 )
				'()
				'()
			)
		)
	)
	(setq adetX (fix (/ x (cm2cu 20.0))))
	(setq adetZ (fix (/ z (cm2cu 26.0))))
	(setq solalt (list (cm2cu 5.0) (cm2cu 5.0)))
	(setq sagust (-pt (list x z) (list (cm2cu 5.0) (cm2cu 5.0))))
	
	(if (not (or (< adetX 1) (< adetZ 1)))
		(kapakHucreCiz solalt sagust adetX adetZ YAYYYY_hucre)
	)
)


