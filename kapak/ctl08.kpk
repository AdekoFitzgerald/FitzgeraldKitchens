(defun CTL08_Akanat (x z)
	(drawMeshKanat nil "CTL08" x z
		(list
			(list "CAB_DOOR_FRAMES"
				nil
				'(5 6 12 16 9 10 11 13 )
				'(2 7 4 15 1 8 3 14 )
				'(2 7 4 15 5 6 12 16 )
				'()
			)
			(list "CAB_DOORS"
				nil
				'(4 3 )
				'(1 2 )
				'(1 4 )
				'()
			)
)))

(defun CTL08_Bkanat (x z)
	(drawMeshKanat nil "CTL08C" x z
		(list
			(list "CAB_DOOR_FRAMES"
				(list (cm 0.2) 14 16 15 13)
				'(8 7 19 23 12 16 9 10 22 18 11 14 )
				'(2 6 20 4 15 24 1 5 17 3 13 21 )
				'(2 6 20 4 15 24 8 7 19 23 12 16 )
				'()
			)
)))

(defun CTL08_Ckanat (x z)
	(CTL08_Akanat x z)
)
