		(list
			(list "CAB_DOOR_FRAMES"
				nil
				'(13 24 16 10 28 11 1 2 20 23 22 9 25 12 7 8 )
				'(29 31 32 14 18 15 3 4 26 30 27 17 21 19 5 6 )
				'(29 31 32 14 18 15 3 4 13 24 16 10 28 11 1 2 )
				'()
			)
			(list "CAB_DOORS"
				nil
				'(4 6 3 8 )
				'(2 7 1 5 )
				'(2 7 4 6 )
				'()
			)
)))

