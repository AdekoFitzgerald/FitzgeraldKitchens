(defun CTL6P_Akanat (x z)
	(drawMeshKanat nil "CTL6P" x z
		(list
			(list "CAB_DOOR_FRAMES"
				nil
				'(6 12 5 24 16 19 9 22 14 17 10 11 )
				'(2 4 15 20 7 23 8 21 13 18 1 3 )
				'(2 4 15 20 7 23 6 12 5 24 16 19 )
				'()
			)
			(list "CAB_DOORS"
				nil
				'(1 3 )
				'(4 2 )
				'(4 1 )
				'()
			)
)))

(defun CTL6P_Bkanat (x z)
	(drawMeshKanat nil "CTL6PC" x z
		(list
			(list "CAB_DOOR_FRAMES"
				(list (cm 0.2) 22 24 23 21)
				'(6 12 5 24 16 19 9 22 14 17 10 11 )
				'(2 4 15 20 7 23 8 21 13 18 1 3 )
				'(2 4 15 20 7 23 6 12 5 24 16 19 )
				'()
			)
)))

(defun CTL6P_Ckanat (x z)
	(if (<= z (cm 13.0))
		(progn
			(drawMeshKanat nil "CTL6PKS" x z
					(list
						(list "CAB_DOOR_FRAMES"
							nil
							'(6 12 5 24 16 19 9 22 14 17 10 11 )
							'(2 4 15 20 7 23 8 21 13 18 1 3 )
							'(2 4 15 20 7 23 6 12 5 24 16 19 )
							'()
						)
						(list "CAB_DOORS"
							nil
							'(1 3 )
							'(4 2 )
							'(4 1 )
							'()
						)
			))
		)
		(CTL6P_Akanat x z)
	)
)