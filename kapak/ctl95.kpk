(defun CTL95_Akanat (x z)
    (if (<= z (cm 20.0))
        (CTL95_Ckanat x z)
        (progn
			(drawMeshKanat nil "CTL95" x z
				(list
					(list "CAB_DOORS"
						nil
						'( 32 31 30 24 23 21 19 17 14 13 11 10 8 7 6 5 )
						'( 29 28 27 26 25 22 20 18 16 15 12 9 4 3 2 1 )
						'( 32 31 30 29 28 27 21 20 12 11 10 9 7 5 4 1 )
						'( )
					)
)))))

(defun CTL95_Bkanat (x z)
    (drawMeshKanat nil "CTL95C" x z
        (list
            (list "CAB_DOORS"
                (list (cm -0.7) 5 9 10 7 )
                '( 32 31 30 24 23 21 18 17 15 13 12 11 9 8 6 5 )
                '( 29 28 27 26 25 22 20 19 16 14 10 7 4 3 2 1 )
                '( 32 31 30 29 28 27 16 15 14 13 11 10 9 8 4 1 )
                '( )
            )
)))

(defun CTL95_Ckanat (x z)
    (if (> z (cm 20.0))
        (CTL95_Akanat x z)
        (progn
			(drawMeshKanat nil "CTL95S" x z
				(list
					(list "CAB_DOORS"
						nil
						'( 20 19 18 12 11 9 4 3 2 1 )
						'( 17 16 15 14 13 10 8 7 6 5 )
						'( 20 19 18 17 16 15 14 13 12 11 )
						'( )
					)
)))))
