(defun CTLSRT_Akanat (x z)
	(drawMeshKanat nil "CTLSRT" x z
		(list
			(list "CAB_DOOR_FRAMES"
				nil
				'(3 5 2 6 7 12 25 31 26 30 17 14 18 19 13 24 )
				'(4 9 10 8 1 11 27 32 28 29 16 21 22 20 15 23 )
				'(4 9 10 8 1 11 27 32 3 5 2 6 7 12 25 31 )
				'()
			)
			(list "CAB_DOORS"
				nil
				'(4 3 )
				'(1 2 )
				'(1 4 )
				'()
			)
)))

(defun CTLSRT_Bkanat (x z)
	(drawMeshKanat nil "CTLSRTC" x z
		(list
			(list "CAB_DOOR_FRAMES"
				(list (cm 0.7) 22 18 7 6)
				'(17 18 16 13 14 15 21 19 23 24 20 22 )
				'(9 10 11 8 7 12 1 2 3 4 5 6 )
				'(9 10 11 8 7 12 17 18 16 13 14 15 )
				'()
			)
)))

(defun CTLSRT_Ckanat (x z)
	(CTLSRT_Akanat x z)
)
