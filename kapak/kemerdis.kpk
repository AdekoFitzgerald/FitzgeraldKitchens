(defun KEMERDIS_Akanat (x z / nokta_list dugum_list ax dt et rt)
	(setq et (- ad_ET))
	(setq ax (/2 x))
	(setq dt ad_Clear)
	(nokta+liste (- dt ax)		0.0				dt)
	(nokta+liste (- dt ax)		0.0				(- z dt))
	(nokta+liste (- dt ax)		(+ (cm 0.5) et)		dt)
	(nokta+liste (- dt ax)		(+ (cm 0.5) et)		(- z dt))
	(nokta+liste (- dt ax (cm -0.5))	et				(+ (cm 0.5) dt))
	(nokta+liste (- dt ax (cm -0.5))	et				(- z (cm 0.5) dt))

	(nokta+liste (- (cm 6.000) ax)	et				(cm 6.0))
	(nokta+liste (- (cm 6.000) ax)	et				(- z (cm 12.251)))

	(setq rt (/ (- ax (cm 6.0)) 19.0))   ; 50/2-6=19
 	(nokta+liste (- (+ (cm 6.0) (* rt  4.964)) ax)	et				(- z  (cm 9.243)))
	(nokta+liste (- (+ (cm 6.0) (* rt 10.389)) ax)	et				(- z  (cm 7.180)))
	(nokta+liste (- (+ (cm 6.0) (* rt 16.098)) ax)	et				(- z  (cm 6.132)))

	(nokta+liste (- (cm 7.0) ax)	(cm -2.5)		(cm 7.0))
	(nokta+liste (- (cm 7.0) ax)	(cm -2.5)		(- z (cm 12.761)))

	(setq rt (/ (- ax (cm 7.0)) 18.0))   ; 50/2-7=18
 	(nokta+liste (- (+ (cm 7.0) (* rt  4.725)) ax)	(cm -2.5)			(- z  (cm 9.986)))
 	(nokta+liste (- (+ (cm 7.0) (* rt  9.866)) ax)	(cm -2.5)			(- z  (cm 8.086)))
 	(nokta+liste (- (+ (cm 7.0) (* rt 15.260)) ax)	(cm -2.5)			(- z  (cm 7.121)))

	(nokta+liste (-x 1 0.0) nil nil)
	(nokta+liste (-x 2 0.0) nil nil)
	(nokta+liste (-x 3 0.0) nil nil)
	(nokta+liste (-x 4 0.0) nil nil)
	(nokta+liste (-x 5 0.0) nil nil)
	(nokta+liste (-x 6 0.0) nil nil)
	(nokta+liste (-x 7 0.0) nil nil)
	(nokta+liste (-x 8 0.0) nil nil)
	(nokta+liste (-x 9 0.0) nil nil)
	(nokta+liste (-x 10 0.0) nil nil)
	(nokta+liste (-x 11 0.0) nil nil)
	(nokta+liste (-x 12 0.0) nil nil)
	(nokta+liste (-x 13 0.0) nil nil)
	(nokta+liste (-x 14 0.0) nil nil)
	(nokta+liste (-x 15 0.0) nil nil)
	(nokta+liste (-x 16 0.0) nil nil)

	(dugum+liste (list
		1	2	18	17	""
		1	2	4	3	""
		2	18	20	4	""
		18	20	19	17	""
		19	17	1	3	""
		3	4	6	5	""
		4	6	22	20	""
		20	22	21	19	""
		19	21	5	3	""
		
		6	-5	7	8	9	10	11	-27	22	""
		22	-21	23	24	25	26	-27	""
		5	-21	23	-7	""

		7	8	13	12	""
		8	-9	14	13	""
		9	-10	15	-14	""
		10	-11	16	-15	""
		11	-27	32	-16	""
		27	-26	31	-32	""
		26	-25	30	-31	""
		25	24	29	-30	""
		24	29	28	23	""
		7	12	28	23	""
		
		12	13	14	15	16	32	31	30	29	28	""
	))
	(setlayer "CAB_DOORS" 7)
	(meshciz)
	(entlast)
)

(defun KEMERDIS_Bkanat (x z / nokta_list dugum_list ax dt et rt subblk_list)
    (if (null KEMER_Bkanat) (load (strcat ad_ADEKOPath "kapak\\KEMER.KPK")))
    (KEMER_Bkanat x z)
)


(defun KEMERDIS_Ckanat (x z)
	(DUZKPK_Akanat x z)
)

(defun KEMERDIS_Dkanat (x z)
	(Dkanat '(KEMERDIS_Akanat) x z)
)

