(defun KLASIK2_Akanat (x z / nokta_list dugum_list ax dt et rt)
	(setq Ta (cm 2.0) Sa (cm 2.0))
	(if (< z (cm 20.0))
		(KLASIK2_Ckanat x z)
		(progn
			(setq Ta (cm 3.0) Sa (cm 3.0))
			(setq et (- ad_ET))
			(setq ax (/2 x))
			(setq dt ad_Clear)
			(nokta+liste (- dt ax)		0.0				dt)
			(nokta+liste (- dt ax)		0.0				(- z dt))
			(nokta+liste (- dt ax)		(+ (cm 0.5) et)		dt)
			(nokta+liste (- dt ax)		(+ (cm 0.5) et)		(- z dt))
			(nokta+liste (- dt ax (cm -0.5))	et				(+ (cm 0.5) dt))
			(nokta+liste (- dt ax (cm -0.5))	et				(- z (cm 0.5) dt))

			(nokta+liste (- (cm 5.500) ax)	et			(cm 5.5))
			(nokta+liste (- (cm 5.500) ax)	et			(- z (cm 5.5)))
			(nokta+liste (- (cm 6.500) ax)	(cm -1.0)		(cm 6.5))
			(nokta+liste (- (cm 6.500) ax)	(cm -1.0)		(- z (cm 6.5)))
			(nokta+liste (- (cm 9.000) ax)	(cm -1.0)		(cm 9.0))
			(nokta+liste (- (cm 9.000) ax)	(cm -1.0)		(- z (cm 9.0)))
			(nokta+liste (- (cm 9.000) ax)	et			(cm 9.0))
			(nokta+liste (- (cm 9.000) ax)	et			(- z (cm 9.0)))
			(nokta+liste (cm -1.250)			et			(cm 9.0))
			(nokta+liste (cm -1.250)			et			(- z (cm 9.0)))
			(nokta+liste (cm -1.250)			(cm -1.0)		(cm 9.0))
			(nokta+liste (cm -1.250)			(cm -1.0)		(- z (cm 9.0)))

			(nokta+liste (-x 1 0.0) nil nil)
			(nokta+liste (-x 2 0.0) nil nil)
			(nokta+liste (-x 3 0.0) nil nil)
			(nokta+liste (-x 4 0.0) nil nil)
			(nokta+liste (-x 5 0.0) nil nil)
			(nokta+liste (-x 6 0.0) nil nil)
			(nokta+liste (-x 7 0.0) nil nil)
			(nokta+liste (-x 8 0.0) nil nil)
			(nokta+liste (-x 9 0.0) nil nil)
			(nokta+liste (-x 10 0.0) nil nil)
			(nokta+liste (-x 11 0.0) nil nil)
			(nokta+liste (-x 12 0.0) nil nil)
			(nokta+liste (-x 13 0.0) nil nil)
			(nokta+liste (-x 14 0.0) nil nil)
			(nokta+liste (-x 15 0.0) nil nil)
			(nokta+liste (-x 16 0.0) nil nil)
			(nokta+liste (-x 17 0.0) nil nil)
			(nokta+liste (-x 18 0.0) nil nil)

			(dugum+liste (list
				1	2	20	19	""
				1	2	4	3	""
				2	20	22	4	""
				20	22	21	19	""
				21	19	1	3	""
				3	4	6	5	""
				4	6	24	22	""
				22	24	23	21	""
				23	21	3	5	""
				
				6	-5	7	8	-26	24	""
				23	-24	26	25	-7	5	""
				7	8	10	9	""
				8	10	28	26	""
				26	28	27	25	""
				25	27	9	7	""
				9	10	28	27	""
				11	12	14	13	""
				12	18	16	14	""
				18	17	15	16	""
				17	11	13	15	""
				13	14	16	15	""
				
				29	30	32	31	""
				30	36	34	32	""
				36	35	33	34	""
				35	29	31	33	""
				31	32	34	33	""
			))
			(setlayer "CAB_DOORS" 7)
			(meshciz)
			(entlast)
		)
	)
)

(defun KLASIK2_Bkanat (x z)
(setq Ta (cm 2.0) Sa (cm 2.0))
	(if (null KLASIK1_Bkanat) (load (strcat ad_ADEKOPath "kapak\\KLASIK1.KPK")))
	(KLASIK1_Bkanat x z)
)

(defun KLASIK2_Ckanat (x z / nokta_list dugum_list ax dt et rt)
	(setq DRMode "C")
	(setq et (- ad_ET))
	(setq ax (/2 x))
	(setq dt ad_Clear)
	(nokta+liste (- dt ax)		0.0				dt)
	(nokta+liste (- dt ax)		0.0				(- z dt))
	(nokta+liste (- dt ax)		(+ (cm 0.5) et)		dt)
	(nokta+liste (- dt ax)		(+ (cm 0.5) et)		(- z dt))
	(nokta+liste (- dt ax (cm -0.5))	et				(+ (cm 0.5) dt))
	(nokta+liste (- dt ax (cm -0.5))	et				(- z (cm 0.5) dt))

	(nokta+liste (- (cm 5.500) ax)	et			(cm 3.0))
	(nokta+liste (- (cm 5.500) ax)	et			(- z (cm 3.0)))
	(nokta+liste (- (cm 5.750) ax)	-1.5		(cm 3.25))
	(nokta+liste (- (cm 5.750) ax)	-1.5		(- z (cm 3.25)))
	(nokta+liste (- (cm 6.750) ax)	-1.5		(cm 4.25))
	(nokta+liste (- (cm 6.750) ax)	-1.5		(- z (cm 4.25)))
	(nokta+liste (- (cm 7.000) ax)	et  		(cm 4.50))
	(nokta+liste (- (cm 7.000) ax)	et  		(- z (cm 4.50)))

	(nokta+liste (-x 1 0.0) nil nil)
	(nokta+liste (-x 2 0.0) nil nil)
	(nokta+liste (-x 3 0.0) nil nil)
	(nokta+liste (-x 4 0.0) nil nil)
	(nokta+liste (-x 5 0.0) nil nil)
	(nokta+liste (-x 6 0.0) nil nil)
	(nokta+liste (-x 7 0.0) nil nil)
	(nokta+liste (-x 8 0.0) nil nil)
	(nokta+liste (-x 9 0.0) nil nil)
	(nokta+liste (-x 10 0.0) nil nil)
	(nokta+liste (-x 11 0.0) nil nil)
	(nokta+liste (-x 12 0.0) nil nil)
	(nokta+liste (-x 13 0.0) nil nil)
	(nokta+liste (-x 14 0.0) nil nil)

	(dugum+liste (list
		1	2	16	15	""
		1	2	4	3	""
		2	16	18	4	""
		16	18	17	15	""
		17	15	1	3	""
		3	4	6	5	""
		4	6	20	18	""
		18	20	19	17	""
		19	17	3	5	""

		6	-5	7	8	-22	20	""
		19	-20	22	21	-7	5	""
		7	8	10	9	""
		8	10	24	22	""
		22	24	23	21	""
		21	23	9	7	""
		9	10	24	23	""
		11	12	26	25	""
		12	14	28	26	""
		26	28	27	25	""
		25	27	13	11	""
		13	14	28	27	""
	))
	(setlayer "CAB_DOORS" 7)
	(meshciz)
	(entlast)
)