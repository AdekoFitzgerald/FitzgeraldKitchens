(defun KLASIK3_Akanat (x z / nokta_list dugum_list ax dt et rt)
(setq Ta (cm 2.0) Sa (cm 2.0))
	(if (<= z (cm 20.0))
		(KLASIK3_Ckanat x z)
		(progn
	(setq et (- ad_ET))
	(setq ax (/2 x))
	(setq dt ad_Clear)
	(nokta+liste (- dt ax)		0.0				dt)
	(nokta+liste (- dt ax)		0.0				(- z dt))
	(nokta+liste (- dt ax)		(+ (cm 1.0) et)		dt)
	(nokta+liste (- dt ax)		(+ (cm 1.0) et)		(- z dt))
	(nokta+liste (- dt ax (cm -1.0))	et				(+ (cm 1.0) dt))
	(nokta+liste (- dt ax (cm -1.0))	et				(- z (cm 1.0) dt))

	(nokta+liste (- (cm 5.500) ax)	et			(cm 5.5))
	(nokta+liste (- (cm 5.500) ax)	et			(- z (cm 5.5)))
	(nokta+liste (- (cm 6.500) ax)	(cm -1.0)		(cm 6.5))
	(nokta+liste (- (cm 6.500) ax)	(cm -1.0)		(- z (cm 6.5)))
	(nokta+liste (- (cm 8.500) ax)	(cm -1.0)		(cm 8.5))
	(nokta+liste (- (cm 8.500) ax)	(cm -1.0)		(- z (cm 8.5)))
	(nokta+liste (- (cm 9.500) ax)	et			(cm 9.5))
	(nokta+liste (- (cm 9.500) ax)	et			(- z (cm 9.5)))
	(nokta+liste (cm -6.500)			et			(cm 9.5))
	(nokta+liste (cm -6.500)			et			(- z (cm 9.5)))
	(nokta+liste (cm -5.500)			(cm -1.0)		(cm 8.5))
	(nokta+liste (cm -5.500)			(cm -1.0)		(- z (cm 8.5)))
	(nokta+liste (cm -3.500)			(cm -1.0)		(cm 6.5))
	(nokta+liste (cm -3.500)			(cm -1.0)		(- z (cm 6.5)))
	(nokta+liste (cm -2.500)			et			(cm 5.5))
	(nokta+liste (cm -2.500)			et			(- z (cm 5.5)))

	(nokta+liste (-x 1 0.0) nil nil)
	(nokta+liste (-x 2 0.0) nil nil)
	(nokta+liste (-x 3 0.0) nil nil)
	(nokta+liste (-x 4 0.0) nil nil)
	(nokta+liste (-x 5 0.0) nil nil)
	(nokta+liste (-x 6 0.0) nil nil)
	(nokta+liste (-x 7 0.0) nil nil)
	(nokta+liste (-x 8 0.0) nil nil)
	(nokta+liste (-x 9 0.0) nil nil)
	(nokta+liste (-x 10 0.0) nil nil)
	(nokta+liste (-x 11 0.0) nil nil)
	(nokta+liste (-x 12 0.0) nil nil)
	(nokta+liste (-x 13 0.0) nil nil)
	(nokta+liste (-x 14 0.0) nil nil)
	(nokta+liste (-x 15 0.0) nil nil)
	(nokta+liste (-x 16 0.0) nil nil)
	(nokta+liste (-x 17 0.0) nil nil)
	(nokta+liste (-x 18 0.0) nil nil)
	(nokta+liste (-x 19 0.0) nil nil)
	(nokta+liste (-x 20 0.0) nil nil)
	(nokta+liste (-x 21 0.0) nil nil)
	(nokta+liste (-x 22 0.0) nil nil)

	(dugum+liste (list
		1	2	24	23	""
		1	2	4	3	""
		2	24	26	4	""
		24	26	25	23	""
		23	25	3	1	""
		3	4	6	5	""
		4	6	28	26	""
		26	28	27	25	""
		25	27	5	3	""
		
		6	-5	7	8	-22	28	""
		44	-30	-28	22	-21	43	""
		27	-28	30	29	-43	5	""
		21	-7	-5	-43	""
		
		7	9	10	8	""
		8	10	20	22	""
		20	22	21	19	""
		19	21	7	9	""

		9	-10	32	-31	""
		
		11	13	14	12	""
		12	14	16	18	""
		16	18	17	15	""
		15	17	11	13	""
		13	14	16	15	""
		
		29	31	32	30	""
		30	32	42	44	""
		42	44	43	41	""
		41	43	29	31	""

		33	35	36	34	""
		34	36	38	40	""
		38	40	39	37	""
		37	39	33	35	""
		35	36	38	37	""
	))
	(setlayer "CAB_DOORS" 7)
	(meshciz)
	(entlast)
	))
)

(defun KLASIK3_Bkanat (x z)
(setq Ta (cm 2.0) Sa (cm 2.0))
	(if (null KLASIK1_Bkanat)
		(load (strcat ad_ADEKOPath "kapak\\KLASIK1.KPK"))
	)
	(KLASIK1_Bkanat x z)
)

(defun KLASIK3_Ckanat (x z / nokta_list dugum_list ax dt et rt)
	(if (> z (cm 20.0))
		(KLASIK3_Akanat x z)
		(progn
	(setq et (- ad_ET))
	(setq ax (/2 x))
	(setq dt ad_Clear)
	(nokta+liste (- dt ax)		0.0				dt)
	(nokta+liste (- dt ax)		0.0				(- z dt))
	(nokta+liste (- dt ax)		(+ (cm 0.5) et)		dt)
	(nokta+liste (- dt ax)		(+ (cm 0.5) et)		(- z dt))
	(nokta+liste (- dt ax (cm -0.5))	et				(+ (cm 0.5) dt))
	(nokta+liste (- dt ax (cm -0.5))	et				(- z (cm 0.5) dt))

	(nokta+liste (- (cm 5.500) ax)	et			(cm 3.0))
	(nokta+liste (- (cm 5.500) ax)	et			(- z (cm 3.0)))
	(nokta+liste (- (cm 6.000) ax)	(cm -1.0)		(cm 3.50))
	(nokta+liste (- (cm 6.000) ax)	(cm -1.0)		(- z (cm 3.50)))
	(nokta+liste (- (cm 8.000) ax)	(cm -1.0)		(cm 5.50))
	(nokta+liste (- (cm 8.000) ax)	(cm -1.0)		(- z (cm 5.50)))
	(nokta+liste (- (cm 8.500) ax)	et  		(cm 6.00))
	(nokta+liste (- (cm 8.500) ax)	et  		(- z (cm 6.00)))

	(nokta+liste (-x 1 0.0) nil nil)
	(nokta+liste (-x 2 0.0) nil nil)
	(nokta+liste (-x 3 0.0) nil nil)
	(nokta+liste (-x 4 0.0) nil nil)
	(nokta+liste (-x 5 0.0) nil nil)
	(nokta+liste (-x 6 0.0) nil nil)
	(nokta+liste (-x 7 0.0) nil nil)
	(nokta+liste (-x 8 0.0) nil nil)
	(nokta+liste (-x 9 0.0) nil nil)
	(nokta+liste (-x 10 0.0) nil nil)
	(nokta+liste (-x 11 0.0) nil nil)
	(nokta+liste (-x 12 0.0) nil nil)
	(nokta+liste (-x 13 0.0) nil nil)
	(nokta+liste (-x 14 0.0) nil nil)

	(dugum+liste (list
		1	2	16	15	""
		1	2	4	3	""
		2	16	18	4	""
		16	18	17	15	""
		17	15	1	3	""
		3	4	6	5	""
		4	6	20	18	""
		18	20	19	17	""
		19	17	3	5	""

		6	-5	7	8	-22	20	""
		19	-20	22	21	-7	5	""
		7	8	10	9	""
		8	10	24	22	""
		22	24	23	21	""
		21	23	9	7	""
		9	10	24	23	""
		11	12	26	25	""
		12	14	28	26	""
		26	28	27	25	""
		25	27	13	11	""
		13	14	28	27	""
	))
	(setlayer "CAB_DOORS" 7)
	(meshciz)
	(entlast)
		);eof progn
	);eof if
)
	
(defun KLASIK3_Dkanat (x z)
	(Dkanat '(KLASIK3_Akanat) x z)
)
