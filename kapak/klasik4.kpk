(defun KLASIK4_Akanat (x z)
	(setq Ta (cm 2.0) Sa (cm 2.0))
    (if (> z (cm 24.0))
        (progn
            (if (null KLASIK1_Akanat) (load (strcat ad_AdekoPath "kapak\\KLASIK1.KPK")))
            (KLASIK1_Akanat x z)
        )
        (DUZKPK_Akanat x z)
    )
)

(defun KLASIK4_Bkanat (x z / f:kayit nokta_list dugum_list ax dt et rt sblklst
(setq Ta (cm 2.0) Sa (cm 2.0))
                        raf# dik#   ;Yatay ve dikey kayýt adetleri
                        kayitboy    ;Dik kayýtlarin boylarý
                        dikdist     ;Dik Kayýt ara mesafeleri
                        i j
                        elast
                        )
    (defun f:kayit (x z len rot)    ;x ve z kayýt ortasýnýn koords
	(if (equal rot 0.0)
		(progn
               (nokta+liste (- x (/2 len))     -2  (+ z 1.25))
               (nokta+liste (- x (/2 len) -1)  -1  (+ z 2.25))
               (nokta+liste (-z 2 z) nil nil)
               (nokta+liste (-z 1 z) nil nil)

               (nokta+liste (-x 1 x) nil nil)
               (nokta+liste (-x 2 x) nil nil)
               (nokta+liste (-x 3 x) nil nil)
               (nokta+liste (-x 4 x) nil nil)
           )
           (progn
               (nokta+liste (+ x 1.25)     -2  (+ z (/2 len)))
               (nokta+liste (+ x 2.25)     -1  (+ z (/2 len) -1))
               (nokta+liste (-x 2 x) nil nil)
               (nokta+liste (-x 1 x) nil nil)

               (nokta+liste (-z 1 z) nil nil)
               (nokta+liste (-z 2 z) nil nil)
               (nokta+liste (-z 3 z) nil nil)
               (nokta+liste (-z 4 z) nil nil)
           )
       )
       (dugum+liste '(
           1 4 8 5 ""
           1 2 6 5 ""
           4 3 7 8 ""
       ))
       (meshciz)
       (ssadd (entlast) sblklst)
	)
	
    (if (null KLASIK1_Bkanat) (load (strcat ad_AdekoPath "kapak\\KLASIK1.KPK")))
    (setq sblklst (KLASIK1_Bkanat x z))
    (setlayer "CAB_DOORS" 7)

    (setq elast (entlast))
;    (UCS_O (list (* -0.5 x) 0 0))
    (setq raf# (fix (/ z 40.0))
          dik# (fix (/ x 30.0)))
    (setq kayitboy (/ (- z 12.0 (* raf# 2.5)) (1+ raf#))
          dikDist  (/ (- x 12.0 (* dik# 2.5)) (1+ dik#))
    )
    (setq i 1)
    (while (<= i raf#)
        (f:kayit (/2 x) (+ 6.0 (* i kayitboy) (* (1- (* 2 i)) 1.25)) (- x 12.0) 0)
        (i++)
    )
    (setq j 0)
    (while (<= j raf#)
        (setq i 1)
        (while (<= i dik#)
            (f:kayit (+ 6.0 (* i dikDist) (* (1- (* 2 i)) 1.25)) (+ 6.0 (/2 kayitboy) (* j (+ 2.5 kayitboy))) kayitboy 90)
            (i++)
        )
        (setq j (1+ j))
    )
    (MOVED (collectMents elast) (list (* -0.5 x) 0 0))
 ;   (UCS_P)
    sblklst
)

(setq KLASIK4_Ckanat KLASIK4_Akanat)

(defun KLASIK4_Dkanat (x z)
    (Dkanat '(KLASIK4_Akanat) x z)
)
