(defun KLS5_Akanat (x z)
	(setq Ta (cm 2.0) Sa (cm 2.0))
	(if (< z (cm 5.0))
		(DUZKPK_Akanat x z)
		(if (<= z (cm 13.0))
		(KLS5_Ckanat x z)
			(progn
				(drawMeshKanat nil "KLS5" x z
					(list
						(list "CAB_DOORS"
							nil
							'(58 59 62 64 44 55 6 54 39 40 43 45 46 50 52 22 10 29 31 34 35 27 1 25 4 7 11 12 13 18 23 19 )
							'(51 57 60 61 63 42 56 53 5 37 38 41 47 48 49 20 24 8 30 32 33 36 28 26 3 2 9 14 15 16 17 21 )
							'(51 57 60 61 63 42 56 53 5 37 38 41 47 48 49 20 58 59 62 64 44 55 6 54 39 40 43 45 46 50 52 22 )
							'()
						)
					)
				)
			)
		)
	)
)

(defun KLS5_Bkanat (x z)
	(setq Ta (cm 2.0) Sa (cm 2.0))
	(drawMeshKanat nil "KLS5C" x z
		(list
			(list "CAB_DOORS"
				(list (cm 0.4) 21 24 23 22)
				'(16 24 20 18 7 8 21 13 9 11 5 6 )
				'(15 19 23 17 1 4 10 14 22 12 2 3 )
				'(15 19 23 17 1 4 16 24 20 18 7 8 )
				'()
			)
)))

(defun KLS5_Ckanat (x z)
	(if (<= z (cm 13.0))
		(progn
			(drawMeshKanat nil "KLS5S" x z
				(list
					(list "CAB_DOORS"
						nil
						'(14 12 7 6 16 11 8 5 )
						'(4 13 10 2 3 15 9 1 )
						'(4 13 10 2 14 12 7 6 )
						'()
					)
				)
			)
		)
		(KLS5_Akanat x z)
	)
)

