(defun KLSFUG_Bkanat (x z)
    (drawMeshKanat nil "KLSFUGC" x z
        (list
            (list "CAB_DOORS"
               	(list (cm -0.5) 8 11 14 15)
                '( 17 16 7 6 )
                '( 4 3 2 1 )
                '( 42 41 40 39 38 37 36 34 33 32 31 30 29 27 25 24 23 22 21 20 18 16 14 13 12 11 10 9 7 5 4 1 )
                '( 44 43 42 41 40 39 38 37 36 35 34 33 32 31 30 29 28 27 26 25 24 23 22 21 20 19 18 15 14 13 12 11 10 9 8 5 )
            )
)))

(defun KLSFUG_Ckanat (x z)
 	(KLSFUG_Akanat x z)
)
