(defun MRDCITA_Akanat (x z)
	(drawMeshKanat nil "MRDCITA" x z
		(list
			(list "CAB_DOOR_FRAMES"
				nil
				'(1 2 31 10 16 24 23 32 7 8 25 9 14 20 18 26 )
				'(4 3 12 15 21 22 29 30 5 6 11 13 17 19 27 28 )
				'(4 3 12 15 21 22 29 30 1 2 31 10 16 24 23 32 )
				'()
			)
			(list "CAB_DOORS"
				nil
				'(6 4 8 3 )
				'(7 2 5 1 )
				'(7 2 6 4 )
				'()
			)
		)
))

(defun MRDCITA_Bkanat (x z)
	(drawMeshKanat nil "MRDCITAC" x z
		(list
			(list "CAB_DOOR_FRAMES"
				nil
				'(2 1 10 16 24 31 23 32 7 8 25 18 26 9 14 20 )
				'(4 3 12 15 22 21 30 29 5 6 17 28 11 13 19 27 )
				'(4 3 12 15 22 21 30 29 2 1 10 16 24 31 23 32 )
				'()
			)
			(list "CAB_DOORS"
				(list (cm 0.8) 1 7 5 3)
				'(15 16 7 8 10 11 1 2 )
				'(13 14 6 5 9 12 4 3 )
				'(13 14 6 5 15 16 7 8 )
				'()
			)
		)
))

(defun MRDCITA_Ckanat (x z)
	(MRDCITA_Akanat x z)
)