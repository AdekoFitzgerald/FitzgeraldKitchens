(defun PAHCITA_Akanat (x z)
	(drawMeshKanat nil "PAHCITA" x z
		(list
			(list "CAB_DOOR_FRAMES"
				nil
				'(2 3 14 11 20 5 6 12 18 19 )
				'(15 1 4 10 17 13 7 8 9 16 )
				'(15 1 4 10 17 2 3 14 11 20 )
				'()
			)
			(list "CAB_DOORS"
				nil
				'(4 6 3 8 )
				'(2 7 1 5 )
				'(2 7 4 6 )
				'()
			)
)))


(defun PAHCITA_Bkanat (x z)
	(drawMeshKanat nil "PAHCITAC" x z
		(list
			(list "CAB_DOOR_FRAMES"
				nil
				'(2 3 14 11 20 5 6 12 18 19 )
				'(15 1 4 10 17 13 7 8 9 16 )
				'(15 1 4 10 17 2 3 14 11 20 )
				'()
			)
			(list "CAB_DOORS"
				(list (cm 0.5) 1 2 5 7)
				'(10 12 2 4 11 9 1 3 )
				'(14 13 6 5 16 15 8 7 )
				'(14 13 6 5 10 12 2 4 )
				'()
			)
)))

(defun PAHCITA_Ckanat (x z)
	(PAHCITA_Akanat x z)
)
