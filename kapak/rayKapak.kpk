(defun rayKapak_Akanat (x z)
       (if (or (< z 30.00)
               (< x 30.00)
           )
        (drawMeshKanat nilF x z 5.00 5.00 5.00 5.00 0.20 0.20 0.80 0.80 "rayKapak (_KAPAK_)" "")
        (drawMeshKanat nilF x z 5.00 5.00 5.00 5.00 0.08 0.05 0.93 0.94 "rayKapak (_KAPAK_)" "r001.jpg")
       )
)

(defun rayKapak_Ckanat (x z)
      (rayKapak_Akanat x z)
)