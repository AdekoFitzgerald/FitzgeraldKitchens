	(meshciz)
	(entlast)
	))
)


(defun RUSTIK1_Bkanat (x z / nokta_list dugum_list ax dt et rt subblk_list i)
	(setq Ta (cm 2.5) Sa (cm 2.5))
	(setq et (- ad_ET))
	(setq ax (/2 x))
	(setq dt ad_Clear)
	(nokta+liste (- dt ax)		0.0				dt)
	(nokta+liste (- dt ax)		0.0				(- z dt))
	(nokta+liste (- dt ax)		(+ (cm 0.5) et)		dt)
	(nokta+liste (- dt ax)		(+ (cm 0.5) et)		(- z dt))
	(nokta+liste (- dt ax (cm -0.5))	et				(+ (cm 0.5) dt))
	(nokta+liste (- dt ax (cm -0.5))	et				(- z (cm 0.5) dt))

	(nokta+liste (- (cm 6.000) ax)	et				(cm 6.0))
 	(nokta+liste (- (cm 6.000) ax)	et				(- z (cm 12.870)))

	(setq rt (/ (- ax (cm 6.0)) 19.0))   ; 50/2-6=19
 	(nokta+liste (- (+ (cm 6.0) (* rt  2.380)) ax)	et				(- z (cm 12.148)))
	(nokta+liste (- (+ (cm 6.0) (* rt  4.608)) ax)	et				(- z (cm 11.043)))
	(nokta+liste (- (+ (cm 6.0) (* rt  6.623)) ax)	et				(- z  (cm 9.584)))
	(nokta+liste (- (+ (cm 6.0) (* rt  9.778)) ax)	et				(- z  (cm 7.388)))
	(nokta+liste (- (+ (cm 6.0) (* rt 13.312)) ax)	et				(- z  (cm 5.872)))
	(nokta+liste (- (+ (cm 6.0) (* rt 17.078)) ax)	et				(- z  (cm 5.098)))

	(nokta+liste (- (cm 7.000) ax)	(cm -1.0)				(cm 7.0))
	(nokta+liste (- (cm 7.000) ax)	(cm -1.0)				(- z (cm 13.657)))

	(setq rt (/ (- ax (cm 7.0)) 18.0))   ; 50/2-7=18
	(nokta+liste (- (+ (cm 7.0) (* rt  2.249)) ax)	(cm -1.0)				(- z (cm 12.869)))
	(nokta+liste (- (+ (cm 7.0) (* rt  4.356)) ax)	(cm -1.0)				(- z (cm 11.756)))
	(nokta+liste (- (+ (cm 7.0) (* rt  6.274)) ax)	(cm -1.0)				(- z (cm 10.343)))
	(nokta+liste (- (+ (cm 7.0) (* rt  9.264)) ax)	(cm -1.0)				(- z (cm 8.262)))
	(nokta+liste (- (+ (cm 7.0) (* rt 12.611)) ax)	(cm -1.0)				(- z (cm 6.826)))
	(nokta+liste (- (+ (cm 7.0) (* rt 16.179)) ax)	(cm -1.0)				(- z (cm 6.092)))

	(setq i 0)
	(repeat 23
		(nokta+liste (-x (i++) 0) nil nil)
	)

;;;	(nokta+liste	(-x 1 0) nil nil)
;;;	(nokta+liste	(-x 2 0) nil nil)
;;;	(nokta+liste	(-x 3 0) nil nil)
;;;	(nokta+liste	(-x 4 0) nil nil)
;;;	(nokta+liste	(-x 5 0) nil nil)
