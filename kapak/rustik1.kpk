(defun RUSTIK1_Akanat (x z / nokta_list dugum_list ax dt et rt i)
	(setq Ta (cm 2.5) Sa (cm 2.5))
	(if (<= z (cm 25.0))
		(progn
			(if (null RUSTIK2_Ckanat) (load (strcat ad_ADEKOPath "\\kapak\\RUSTIK2.KPK")))
			(RUSTIK2_Ckanat x z)
		)
		(progn
	(setq et (- ad_ET))
	(setq ax (/2 x))
	(setq dt ad_Clear)
	(nokta+liste (- dt ax)		0.0				dt)
	(nokta+liste (- dt ax)		0.0				(- z dt))
	(nokta+liste (- dt ax)		(+ (cm 0.5) et)		dt)
	(nokta+liste (- dt ax)		(+ (cm 0.5) et)		(- z dt))
	(nokta+liste (- dt ax (cm -0.5))	et				(+ (cm 0.5) dt))
	(nokta+liste (- dt ax (cm -0.5))	et				(- z (cm 0.5) dt))

	(nokta+liste (- (cm 6.000) ax)	et				(cm 6.0))
 	(nokta+liste (- (cm 6.000) ax)	et				(- z (cm 12.870)))

	(setq rt (/ (- ax (cm 6.0)) 19.0))   ; 50/2-6=19
 	(nokta+liste (- (+ (cm 6.0) (* rt  2.380)) ax)	et				(- z (cm 12.148)))
	(nokta+liste (- (+ (cm 6.0) (* rt  4.608)) ax)	et				(- z (cm 11.043)))
	(nokta+liste (- (+ (cm 6.0) (* rt  6.623)) ax)	et				(- z (cm 9.584)))
	(nokta+liste (- (+ (cm 6.0) (* rt  9.778)) ax)	et				(- z (cm 7.388)))
	(nokta+liste (- (+ (cm 6.0) (* rt 13.312)) ax)	et				(- z (cm 5.872)))
	(nokta+liste (- (+ (cm 6.0) (* rt 17.078)) ax)	et				(- z (cm 5.098)))

	(nokta+liste (- (cm 7.000) ax)	(cm -1.0)				(cm 7.0))
	(nokta+liste (- (cm 7.000) ax)	(cm -1.0)				(- z (cm 13.657)))

	(setq rt (/ (- ax (cm 7.0)) 18.0))   ; 50/2-7=18
	(nokta+liste (- (+ (cm 7.0) (* rt  2.249)) ax)	(cm -1.0)				(- z (cm 12.869)))
	(nokta+liste (- (+ (cm 7.0) (* rt  4.356)) ax)	(cm -1.0)				(- z (cm 11.756)))
	(nokta+liste (- (+ (cm 7.0) (* rt  6.274)) ax)	(cm -1.0)				(- z (cm 10.343)))
	(nokta+liste (- (+ (cm 7.0) (* rt  9.264)) ax)	(cm -1.0)				(- z  (cm 8.262)))
	(nokta+liste (- (+ (cm 7.0) (* rt 12.611)) ax)	(cm -1.0)				(- z  (cm 6.826)))
	(nokta+liste (- (+ (cm 7.0) (* rt 16.179)) ax)	(cm -1.0)				(- z  (cm 6.092)))

	(nokta+liste (- (cm 9.600) ax)	(cm -1.0)				(cm 9.600))
	(nokta+liste (- (cm 9.600) ax)	(cm -1.0)				(- z (cm 15.536)))

	(setq rt (/ (- ax (cm 9.6)) 15.4))   ; 50/2-9.6=15.4
	(nokta+liste (- (+ (cm 9.6) (* rt  1.907)) ax)	(cm -1.0)				(- z (cm 14.677)))
	(nokta+liste (- (+ (cm 9.6) (* rt  3.704)) ax)	(cm -1.0)				(- z (cm 13.589)))
	(nokta+liste (- (+ (cm 9.6) (* rt  5.368)) ax)	(cm -1.0)				(- z (cm 12.316)))
	(nokta+liste (- (+ (cm 9.6) (* rt  7.926)) ax)	(cm -1.0)				(- z (cm 10.535)))
	(nokta+liste (- (+ (cm 9.6) (* rt 10.789)) ax)	(cm -1.0)				(- z (cm 9.306)))
	(nokta+liste (- (+ (cm 9.6) (* rt 13.842)) ax)	(cm -1.0)				(- z (cm 8.679)))

	(nokta+liste (- (cm 10.60) ax)	et				(cm 10.60))
	(nokta+liste (- (cm 10.600) ax)	et				(- z (cm 16.207)))

	(setq rt (/ (- ax (cm 10.6)) 14.4))   ; 50/2-10.6=14.4
	(nokta+liste (- (+ (cm 10.6) (* rt  1.776)) ax)	et				(- z (cm 15.334)))
	(nokta+liste (- (+ (cm 10.6) (* rt  3.455)) ax)	et				(- z (cm 14.286)))
	(nokta+liste (- (+ (cm 10.6) (* rt  5.020)) ax)	et				(- z (cm 13.075)))
	(nokta+liste (- (+ (cm 10.6) (* rt  7.411)) ax)	et				(- z (cm 11.410)))
	(nokta+liste (- (+ (cm 10.6) (* rt 10.089)) ax)	et				(- z (cm 10.261)))
	(nokta+liste (- (+ (cm 10.6) (* rt 12.943)) ax)	et				(- z  (cm 9.674)))

	(setq i 0)
	(repeat 38
		(nokta+liste (-x (i++) 0) nil nil)
	)
;	(nokta+liste	(-x 1 0) nil nil)
;	(nokta+liste	(-x 2 0) nil nil)
;	(nokta+liste	(-x 3 0) nil nil)
;	(nokta+liste	(-x 4 0) nil nil)
;	(nokta+liste	(-x 5 0) nil nil)
;	(nokta+liste	(-x 6 0) nil nil)
;	(nokta+liste	(-x 7 0) nil nil)
;	(nokta+liste	(-x 8 0) nil nil)
;	(nokta+liste	(-x 9 0) nil nil)
;	(nokta+liste	(-x 10 0) nil nil)
;	(nokta+liste	(-x 11 0) nil nil)
;	(nokta+liste	(-x 12 0) nil nil)
;	(nokta+liste	(-x 13 0) nil nil)
;	(nokta+liste	(-x 14 0) nil nil)
;	(nokta+liste	(-x 15 0) nil nil)
;	(nokta+liste	(-x 16 0) nil nil)
;	(nokta+liste	(-x 17 0) nil nil)
;	(nokta+liste	(-x 18 0) nil nil)
;	(nokta+liste	(-x 19 0) nil nil)
;	(nokta+liste	(-x 20 0) nil nil)
;	(nokta+liste	(-x 21 0) nil nil)
;	(nokta+liste	(-x 22 0) nil nil)
;	(nokta+liste	(-x 23 0) nil nil)
;	(nokta+liste	(-x 24 0) nil nil)
;	(nokta+liste	(-x 25 0) nil nil)
;	(nokta+liste	(-x 26 0) nil nil)
;	(nokta+liste	(-x 27 0) nil nil)
;	(nokta+liste	(-x 28 0) nil nil)
;	(nokta+liste	(-x 29 0) nil nil)
;	(nokta+liste	(-x 30 0) nil nil)
;	(nokta+liste	(-x 31 0) nil nil)
;	(nokta+liste	(-x 32 0) nil nil)
;	(nokta+liste	(-x 33 0) nil nil)
;	(nokta+liste	(-x 34 0) nil nil)
;	(nokta+liste	(-x 35 0) nil nil)
;	(nokta+liste	(-x 36 0) nil nil)
;	(nokta+liste	(-x 37 0) nil nil)
;	(nokta+liste	(-x 38 0) nil nil)

	(dugum+liste (list
		1	2	40	39	""
		1	2	4	3	""
		2	40	42	4	""
		40	42	41	39	""
		41	39	1	3	""
		3	4	6	5	""
		4	6	44	42	""
		42	44	43	41	""
		41	43	5	3	""
		
		6	-5	7	8	9	10	11	12	13	14	-52	44	""
		44	-43	45	46	47	48	49	50	51	-52	""
		5	-43	45	-7	""
		
		7	8	16	15	""
		8	-9	17	16	""
		9	-10	18	-17	""
		10	-11	19	-18	""
		11	-12	20	-19	""
		12	-13	21	-20	""
		13	-14	22	-21	""
		14	-52	60	-22	""
		52	-51	59	-60	""
		51	-50	58	-59	""
		50	-49	57	-58	""
		49	-48	56	-57	""
		48	-47	55	-56	""
		47	46	54	-55	""
		46	45	53	54	""
		7	15	53	45	""

		24	25	26	-27	19	18	17	16	-15	23	""
		21	20	-19	27	28	29	-30	22	""
		22	-60	68	-30	""
		59	58	-57	65	66	67	-68	60	""
		62	63	64	-65	57	56	55	54	-53	61	""
		15	-53	61	-23	""

		23	24	32	31	""
		24	-25	33	32	""
		25	-26	34	-33	""
		26	-27	35	-34	""
		27	-28	36	-35	""
		28	-29	37	-36	""
		29	-30	38	-37	""
		30	-68	76	-38	""
