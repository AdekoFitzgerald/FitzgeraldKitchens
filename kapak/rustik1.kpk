		30	29	37	38	""
		7	15	37	29	""
	))
	(setlayer "CAB_DOORS" 7)
	(meshciz)
	(setq subblk_list (ssadd (entlast)))

	(setlayer "CAB_DOOR_GLASS" 4)
;	(command ".3DFACE" (list (- (cm 6.0) ax)  0.0  (cm 6.0))
;						(list (- (cm 6.0) ax)  0.0  (- z (cm 5.0)))
;						(list (- ax (cm 6.0))  0.0  (- z (cm 5.0)))
;						(list (- ax (cm 6.0))  0.0  (cm 6.0))
;						""
;	)
	(command cmdINSERT "CAM" (list (- (cm 6.0) ax)  0.0  (cm 6.0)) 
		"_XYZ" (- x (cm 12.0)) 1 (- z (cm 11.0))
		0
	)
	(setlayer "CAB_DOORS" 7)
	(ssadd (entlast) subblk_list)
)


(defun RUSTIK1_Ckanat (x z)
	(if (> z (cm 25.0))
		(RUSTIK1_Akanat x z)
		(progn
			(if (null RUSTIK2_Ckanat) (load (strcat ad_ADEKOPath "\\kapak\\RUSTIK2.KPK")))
			(RUSTIK2_Ckanat x z)
		)
	)
)

(defun RUSTIK1_Fkanat (EN BOY) ;serit camli
	(RUSTIK1_Bkanat EN BOY)
)
