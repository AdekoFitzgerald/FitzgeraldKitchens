(defun RUSTIK2_Ckanat (x z / nokta_list dugum_list ax dt et az)
	(if (> z (cm 25.0))
		(RUSTIK2_Akanat x z)
		(progn		
	(setq et (- ad_ET))
	(setq ax (/2 x) az (/2 z))
	(setq dt ad_Clear)
	(nokta+liste (- dt ax)		0.0				dt)
	(nokta+liste (- dt ax)		et				dt)
	(nokta+liste (- dt ax (cm -0.5))	et				(+ (cm 0.5) dt))
	(nokta+liste (- (cm 7.166) ax)	et				(- az (cm 4.450)))
	(nokta+liste (- (cm 6.273) ax)	et				(- az (cm 4.177)))
	(nokta+liste (- (cm 5.575) ax)	et				(- az (cm 3.556)))
	(nokta+liste (- (cm 5.200) ax)	et				(- az (cm 2.700)))
	(nokta+liste (- (cm 4.449) ax)	et				(- az (cm 1.750)))
	(nokta+liste (- (cm 4.051) ax)	et				(- az (cm 0.606)))
	(nokta+liste (- (cm 7.188) ax)	-1.0			(- az (cm 3.950)))
	(nokta+liste (- (cm 6.460) ax)	-1.0			(- az (cm 3.707)))
	(nokta+liste (- (cm 5.915) ax)	-1.0			(- az (cm 3.167)))
	(nokta+liste (- (cm 5.666) ax)	-1.0			(- az (cm 2.441)))
	(nokta+liste (- (cm 4.938) ax)	-1.0			(- az (cm 1.599)))
