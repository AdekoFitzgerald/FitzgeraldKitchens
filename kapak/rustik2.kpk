	(nokta+liste (-  (cm 9.372) ax)	(cm -1.0)					(- z (cm 8.163)))

	(setq rt (/ (- ax (cm 9.372)) 20.628))  ;60/2 - 9.372 = 20.628
	(nokta+liste (- (+ (cm 9.372) (* rt 4.471)) ax)	(cm -1.0)	(- z  (cm 6.694)))
