(defun RUSTIK2_Bkanat (x z / nokta_list dugum_list ax dt et rt subblk_list i)
	(setq Ta (cm 2.5) Sa (cm 2.5))
	(setq et (- ad_ET))
	(setq ax (/2 x))
	(setq dt ad_Clear)
	(nokta+liste (- dt ax)		0.0				dt)
	(nokta+liste (- dt ax)		0.0				(- z dt))
	(nokta+liste (- dt ax)		(+ (cm 0.5) et)		dt)
	(nokta+liste (- dt ax)		(+ (cm 0.5) et)		(- z dt))
	(nokta+liste (- dt ax (cm -0.5))	et				(+ (cm 0.5) dt))
	(nokta+liste (- dt ax (cm -0.5))	et				(- z (cm 0.5) dt))

	(nokta+liste (- (cm 5.599) ax)	et				(cm 4.1))
	(nokta+liste (- (cm 4.849) ax)	et				(cm 4.301))
	(nokta+liste (- (cm 4.301) ax)	et				(cm 4.849))
	(nokta+liste (- (cm 4.100) ax)	et				(cm 5.599))

	(nokta+liste (-  (cm 4.100) ax)	et				(- z (cm 12.888)))
