	(nokta+liste (-  (cm 8.860) ax)	et				(- z  (cm 7.363)))
	(nokta+liste (-  (cm 9.265) ax)	et				(- z  (cm 7.135)))

	(setq rt (/ (- ax (cm 9.265)) 20.735))  ;60/2 - 9.265 = 20.735
	(nokta+liste (- (+ (cm 9.265) (* rt 4.471)) ax)	et	(- z  (cm 5.669)))
	(nokta+liste (- (+ (cm 9.265) (* rt 9.045)) ax)	et	(- z  (cm 4.561)))
	(nokta+liste (- (+ (cm 9.265) (* rt 13.70)) ax)	et	(- z  (cm 3.819)))
	(nokta+liste (- (+ (cm 9.265) (* rt 18.382)) ax)	et	(- z  (cm 3.447)))

	(nokta+liste (- (cm 5.599) ax)	(cm -1.0)				(cm 5.1))
	(nokta+liste (- (cm 5.246) ax)	(cm -1.0)					(cm 5.246))
	(nokta+liste (- (cm 5.100) ax)	(cm -1.0)					(cm 5.999))

	(nokta+liste (-  (cm 5.100) ax)	(cm -1.0)					(- z (cm 12.516)))
	(nokta+liste (-  (cm 6.575) ax)	(cm -1.0)					(- z (cm 11.907)))
	(nokta+liste (-  (cm 7.836) ax)	(cm -1.0)					(- z (cm 10.928)))
