(defun RUSTIK2_Akanat (x z / nokta_list dugum_list ax dt et rt i)
	(setq Ta (cm 2.5) Sa (cm 2.5))
	(if (<= z (cm 25.0))
		(RUSTIK2_Ckanat x z)
		(progn
	(setq et (- ad_ET))
	(setq ax (/2 x))
