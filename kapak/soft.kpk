(defun SOFT_Ckanat (x z)
    (SOFT_Akanat x z)
)



(defun SOFT_Akanat (x z)
    (drawMeshKanat nil "SOFT" x z
		(list
			(list "CAB_DOOR_EDGE_BANDS"
				nil
				'(35 44	33 36 37 38 43 45 46 47 34 48 11 16 1 3 12 13 14 17 18 19 10 15 )
				'(26 28	29 30 31 32 39 40 41 42 25 27 8 22 2 4 5 6 7 20 21 23 9 24 )
				'(26 28	29 30 31 32 39 40 41 42 25 27 35 44 33 36 37 38 43 45 46 47 34 48 )
				'()
		    )
			(list "CAB_DOOR_FRAMES"
				nil
				'(15 6 7 9 11 13 2 4 16	5 8 10 12 14 1 3 )
				'(19 28	29 30 31 27 20 32 17 21 22 23 24 26 18 25 )
				'(19 28	29 30 31 27 20 32 15 6 7 9 11 13 2 4 )
				'()
		    )
			(list "CAB_DOORS"
				nil
				'(8	3 6 4 )
				'(7	1 5 2 )
				'(7	1 8 3 )
				'()
		    )
)))

(defun SOFT_Bkanat (x z)
    (drawMeshKanat nil "SOFTC" x z
		(list
			(list "CAB_DOOR_EDGE_BANDS"
				nil
				'(35 44	33 36 37 38 43 45 46 47 34 48 11 16 1 3 12 13 14 17 18 19 10 15 )
				'(26 28	29 30 31 32 39 40 41 42 25 27 8 22 2 4 5 6 7 20 21 23 9 24 )
				'(26 28	29 30 31 32 39 40 41 42 25 27 35 44 33 36 37 38 43 45 46 47 34 48 )
				'()
		    )
			(list "CAB_DOOR_FRAMES"
				nil
				'(15 6 7 9 11 13 2 4 16	5 8 10 12 14 1 3 )
				'(19 28	29 30 31 27 20 32 17 21 22 23 24 26 18 25 )
				'(19 28	29 30 31 27 20 32 15 6 7 9 11 13 2 4 )
				'()
		    )
			(list "CAB_DOORS"
				(list (cm 1.0) 14 12	16 15)
				'(13 12	7 8 14 10 5 6 )
				'(11 16	1 2 15 9 3 4 )
				'(11 16	1 2 13 12 7 8 )
				'()
		    )
)))

