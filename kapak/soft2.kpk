(defun SOFT2_Ckanat (x z)
    (SOFT2_Akanat x z)
)

(defun SOFT2_Akanat (x z)
    (drawMeshKanat nil "SOFT2" x z
		(list
			(list "CAB_DOOR_FRAMES"
				nil
				'(1	3 16 15 17 18 14 24 5 6 30 29 31 32 22 23 )
				'(4	11 9 10 12 2 13 19 8 27 25 26 28 7 20 21 )
				'(4	11 9 10 12 2 13 19 1 3 16 15 17 18 14 24 )
				'()
			)			 (list "CAB_DOOR_EDGE_BANDS"
				nil
				'(33 36	43 47 35 37 38 44 45 46 34 48 1 3 12 19 11 13 14 16 17 18 10 15 )
				'(30 32	39 40 26 28 29 31 41 42 25 27 2 4 6 20 5 7 8 21 22 23 9 24 )
				'(30 32	39 40 26 28 29 31 41 42 25 27 33 36 43 47 35 37 38 44 45 46 34 48 )
				'()
		    )
			(list "CAB_DOORS"
				nil
				'(7	4 5 2 )
				'(8	3 6 1 )
				'(8	3 7 4 )
				'()
		    )
)))

(defun SOFT2_Bkanat (x z)
    (drawMeshKanat nil "SOFT2C" x z
		(list
			(list "CAB_DOOR_FRAMES"
				nil
				'(1	3 16 15 17 18 14 24 5 6 30 29 31 32 22 23 )
				'(4	11 9 10 12 2 13 19 8 27 25 26 28 7 20 21 )
				'(4	11 9 10 12 2 13 19 1 3 16 15 17 18 14 24 )
				'()
		    )
			(list "CAB_DOOR_EDGE_BANDS"
				nil
				'(33 36	43 47 35 37 38 44 45 46 34 48 1 3 12 19 11 13 14 16 17 18 10 15 )
				'(30 32	39 40 26 28 29 31 41 42 25 27 2 4 6 20 5 7 8 21 22 23 9 24 )
				'(30 32	39 40 26 28 29 31 41 42 25 27 33 36 43 47 35 37 38 44 45 46 34 48 )
				'()
		    )
			(list "CAB_DOORS"
				(list (cm 1.0) 5	6 10 9)
				'(6	8 12 16 5 7 11 15 )
				'(3	10 4 14 1 9 2 13 )
				'(3	10 4 14 6 8 12 16 )
				'()
		    )
)))

