(defun SOFT4_Akanat (x z)
	(drawMeshKanat nil "SOFT4" x z
		(list
			(list "CAB_DOORS"	;Layername
				  nil
				'(6 7 9 16 26 27 28 29 34 36 37 39 40 41 42 43 44 10 14 15 20 21 22 30 31 33 35 38 45 46 47 48 49 50 )
				'(1 2 5 8 11 23 24 25 51 52 53 57 58 59 60 61 62 3 4 12 13 17 18 19 32 54 55 56 63 64 65 66 67 68 )
				'(1 2 5 8 11 23 24 25 51 52 53 57 58 59 60 61 62 6 7 9 16 26 27 28 29 34 36 37 39 40 41 42 43 44 )
					;     DWN '(3 4 12 13 17 18 19 32 54 55 56 63 64 65 66 67 68 10 14 15 20 21 22 30 31 33 35 38 45 46 47 48 49 50 )
				  nil	;Scale
			)
		)
	)
)

(defun SOFT4_Bkanat (x z)
	(drawMeshKanat nil "SOFT4C" x z
		(list
			(list "CAB_DOORS"	;Layername
				(list (cm 0.8) 9 15 13 11)	;(offset p1 p2 p3 p4). Also serves as a flag that this is a Bkanat
				'(6 7 16 22 23 24 25 37 41 42 46 47 48 49 50 51 52 15 21 9 32 10 27 28 29 30 31 38 39 43 44 45 53 54 55 56 57 58 )
 				'(1 2 5 8 14 17 18 19 59 60 61 65 66 67 68 69 70 13 20 11 26 3 4 12 33 34 35 36 40 62 63 64 71 72 73 74 75 76 )
  				'(1 2 5 8 14 17 18 19 59 60 61 65 66 67 68 69 70 13 20 6 7 16 22 23 24 25 37 41 42 46 47 48 49 50 51 52 15 21 )
				  nil	;Scale
			)
		)
	)
)

(defun SOFT4_Ckanat (x z)
	(SOFT4_Akanat x z)
)


